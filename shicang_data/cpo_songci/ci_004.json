[{"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "沙上寒鸥接翼飞。\n潮生潮落水东西。\n征船鸣橹趁潮归。\n望断碧云无锦字，谩题红叶有新诗。\n黄昏微雨倚阑时。", "lines": ["沙上寒鸥接翼飞。", "潮生潮落水东西。", "征船鸣橹趁潮归。", "望断碧云无锦字，谩题红叶有新诗。", "黄昏微雨倚阑时。"], "pingsheng": ["·····z··", "···z····", "········", "················", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "漠漠新田绿未齐。\n柳阴阴下水平堤。\n竹间时有乳鸦啼。\n云敛屏山横枕畔，夜阑璧月转林西。\n玉芝香里彩鸳栖。", "lines": ["漠漠新田绿未齐。", "柳阴阴下水平堤。", "竹间时有乳鸦啼。", "云敛屏山横枕畔，夜阑璧月转林西。", "玉芝香里彩鸳栖。"], "pingsheng": ["····z···", "···z····", "z·······", "···········z····", "z·······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "紫燕双双掠水飞。\n廉纤小雨未成泥。\n篱边开尽野蔷薇。\n会少离多终有恨，暂来还去益堪悲。\n后期重约采莲时。", "lines": ["紫燕双双掠水飞。", "廉纤小雨未成泥。", "篱边开尽野蔷薇。", "会少离多终有恨，暂来还去益堪悲。", "后期重约采莲时。"], "pingsheng": ["········", "········", "········", "················", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "窄窄霜绡稳称身。\n强临歌酒惨离魂。\n故人相遇益伤神。\n断雨残云千里隔，琼枝璧月四时新。\n为君留取镜中春。", "lines": ["窄窄霜绡稳称身。", "强临歌酒惨离魂。", "故人相遇益伤神。", "断雨残云千里隔，琼枝璧月四时新。", "为君留取镜中春。"], "pingsheng": ["········", "········", "········", "······z····z····", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "且斗尊前见在身。\n昔游如梦可销魂。\n玉容依约旧精神。\n千里重来人事改，一杯相属意还新。\n韶华不减洞中春。", "lines": ["且斗尊前见在身。", "昔游如梦可销魂。", "玉容依约旧精神。", "千里重来人事改，一杯相属意还新。", "韶华不减洞中春。"], "pingsheng": ["········", "········", "z·······", "········z·······", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "木似文犀感月华。\n寸根移种自仙家。\n春兰秋菊浪矜夸。\n玉露初零秋夜永，幽香直入小窗纱。\n此时风月独输他。", "lines": ["木似文犀感月华。", "寸根移种自仙家。", "春兰秋菊浪矜夸。", "玉露初零秋夜永，幽香直入小窗纱。", "此时风月独输他。"], "pingsheng": ["z····z··", "········", "···z····", "z··········z····", "···zz···"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "叶剪玻璃芯糁金。\n清香端不数琼沈。\n独将高韵冠芗林。\n千里江山新梦后，一天风露小庭深。\n主人归兴已骎骎。", "lines": ["叶剪玻璃芯糁金。", "清香端不数琼沈。", "独将高韵冠芗林。", "千里江山新梦后，一天风露小庭深。", "主人归兴已骎骎。"], "pingsheng": ["········", "········", "z·······", "········z·······", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "浅褐衫儿寿带藤。\n碾花如意枕冠轻。\n凤鞋弓小称娉婷。\n约略梳妆随事好，出尘标韵出尘清。\n一枝梅映玉壶冰。", "lines": ["浅褐衫儿寿带藤。", "碾花如意枕冠轻。", "凤鞋弓小称娉婷。", "约略梳妆随事好，出尘标韵出尘清。", "一枝梅映玉壶冰。"], "pingsheng": ["········", "········", "········", "················", "z···z···"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "浣溪沙", "author": "蔡伸", "dynasty": "宋", "cipai": "浣溪沙", "text": "窗外桃花烂熳开。\n年时曾伴玉人来。\n一枝斜插凤皇钗。\n今日重来人事改，花前无语独徘徊。\n凄凉怀抱可怜哉。", "lines": ["窗外桃花烂熳开。", "年时曾伴玉人来。", "一枝斜插凤皇钗。", "今日重来人事改，花前无语独徘徊。", "凄凉怀抱可怜哉。"], "pingsheng": ["········", "····z···", "z·······", "·z··········z···", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "瑶琴一弄清商怨。\n楼外桐阴转。\n月华澄淡露华浓。\n寂寞小池烟水、冷芙蓉。\n攀花撷翠当时事。\n绿叶同心字。\n有情还解忆人无。\n过尽寒沙新雁、甚无书。", "lines": ["瑶琴一弄清商怨。", "楼外桐阴转。", "月华澄淡露华浓。", "寂寞小池烟水、冷芙蓉。", "攀花撷翠当时事。", "绿叶同心字。", "有情还解忆人无。", "过尽寒沙新雁、甚无书。"], "pingsheng": ["··z·····", "······", "z·······", "···········", "········", "z·····", "········", "···········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "飞梁石径关山路。\n惨淡秋容暮。\n一行新雁破寒空。\n肠断碧云千里、水溶溶。\n鸾衾欲展谁堪共。\n帘幕霜华重。\n鸭炉香尽锦屏中。\n幽梦今宵何许、与君同。", "lines": ["飞梁石径关山路。", "惨淡秋容暮。", "一行新雁破寒空。", "肠断碧云千里、水溶溶。", "鸾衾欲展谁堪共。", "帘幕霜华重。", "鸭炉香尽锦屏中。", "幽梦今宵何许、与君同。"], "pingsheng": ["··z·····", "······", "z·······", "···········", "··z·····", "······", "········", "···········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "红尘匹马长安道。\n人与花俱老。\n缓垂鞭袖过平康。\n散尽高阳、零落少年场。\n朱弦重理相思调。\n无奈知音少。\n十年如梦尽堪伤。\n乐事如今、回首做凄凉。", "lines": ["红尘匹马长安道。", "人与花俱老。", "缓垂鞭袖过平康。", "散尽高阳、零落少年场。", "朱弦重理相思调。", "无奈知音少。", "十年如梦尽堪伤。", "乐事如今、回首做凄凉。"], "pingsheng": ["········", "······", "········", "······z····", "········", "······", "z·······", "z··········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "彩旗摇曳樯乌转。\n鹢首征帆展。\n高城楼观暮云平。\n叠鼓凝笳都在、断肠声。\n绿窗朱户空回首。\n明月还依旧。\n乱山无数水茫茫。\n谁念塞垣风物、㬠凄惶。", "lines": ["彩旗摇曳樯乌转。", "鹢首征帆展。", "高城楼观暮云平。", "叠鼓凝笳都在、断肠声。", "绿窗朱户空回首。", "明月还依旧。", "乱山无数水茫茫。", "谁念塞垣风物、㬠凄惶。"], "pingsheng": ["········", "······", "········", "···········", "z·······", "·z····", "········", "··z··z·····"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "堆琼滴露冰壶莹。\n楼外天如镜。\n水晶双枕衬云鬟。\n卧看千山明月、听潺湲。\n渡江桃叶分飞后。\n马上犹回首。\n邮亭今夜月空圆。\n不似当时携手、对婵娟。", "lines": ["堆琼滴露冰壶莹。", "楼外天如镜。", "水晶双枕衬云鬟。", "卧看千山明月、听潺湲。", "渡江桃叶分飞后。", "马上犹回首。", "邮亭今夜月空圆。", "不似当时携手、对婵娟。"], "pingsheng": ["········", "······", "········", "·····z·····", "········", "······", "····z···", "···········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "碧溪曾寄流红字。\n忍话当时事。\n重来种种尽堪悲。\n有酒盈杯、聊为故人持。\n夜闲剪烛西窗语。\n怀抱今如许。\n尊前莫讶两依依。\n绿鬓朱颜、不似少年时。", "lines": ["碧溪曾寄流红字。", "忍话当时事。", "重来种种尽堪悲。", "有酒盈杯、聊为故人持。", "夜闲剪烛西窗语。", "怀抱今如许。", "尊前莫讶两依依。", "绿鬓朱颜、不似少年时。"], "pingsheng": ["········", "······", "········", "···········", "········", "······", "········", "z··········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "虞美人", "author": "蔡伸", "dynasty": "宋", "cipai": "虞美人", "text": "鸾屏绣被香云拥。\n平帖幽闺梦。\n觉来重试古龙涎。\n深炷玉炉、烧气不烧烟。\n匆匆人去三更也。\n月到回廊下。\n出门无语送郎时。\n泪共一天风露、湿罗衣。", "lines": ["鸾屏绣被香云拥。", "平帖幽闺梦。", "觉来重试古龙涎。", "深炷玉炉、烧气不烧烟。", "匆匆人去三更也。", "月到回廊下。", "出门无语送郎时。", "泪共一天风露、湿罗衣。"], "pingsheng": ["········", "·z····", "z·······", "··z········", "········", "z···z·", "········", "··z····z···"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "生查子", "author": "蔡伸", "dynasty": "宋", "cipai": "生查子", "text": "画堂初见伊，明月当满窗。\n今夜月如眉，话别河桥畔。\n重见约中秋，莫负于飞愿。\n免使月圆时，两处空肠断。", "lines": ["画堂初见伊，明月当满窗。", "今夜月如眉，话别河桥畔。", "重见约中秋，莫负于飞愿。", "免使月圆时，两处空肠断。"], "pingsheng": ["·······z····", "··z····z····", "············", "··z·········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "生查子", "author": "蔡伸", "dynasty": "宋", "cipai": "生查子", "text": "霜寒月满窗，夜永人无寐。\n绛腊有馀情，偏照鸳鸯被。\n看尽旧时书，洒尽今生泪。\n衙鼓已三更，还是和衣睡。", "lines": ["霜寒月满窗，夜永人无寐。", "绛腊有馀情，偏照鸳鸯被。", "看尽旧时书，洒尽今生泪。", "衙鼓已三更，还是和衣睡。"], "pingsheng": ["··z·········", "············", "············", "············"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "生查子", "author": "蔡伸", "dynasty": "宋", "cipai": "生查子", "text": "金壶插玉芝，人面交相照。\n花影满方床，翠叠屏山杳。\n风月亦多情，特地今宵好。\n尽道夜初长，弹指东窗晓。", "lines": ["金壶插玉芝，人面交相照。", "花影满方床，翠叠屏山杳。", "风月亦多情，特地今宵好。", "尽道夜初长，弹指东窗晓。"], "pingsheng": ["···z········", "············", "·zz···z·····", "············"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "生查子", "author": "蔡伸", "dynasty": "宋", "cipai": "生查子", "text": "几番花信风，数点笼丝雨。\n并辔踏香尘，选胜东郊路。\n韶华转首空，谁解留春住。\n幸到绿尊前，且作莺花主。", "lines": ["几番花信风，数点笼丝雨。", "并辔踏香尘，选胜东郊路。", "韶华转首空，谁解留春住。", "幸到绿尊前，且作莺花主。"], "pingsheng": ["············", "··z·········", "············", "··z·········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "生查子", "author": "蔡伸", "dynasty": "宋", "cipai": "生查子", "text": "银缸委坠红，碧锁朦胧晓。\n别泪洒金徽，一曲情多少。\n邮亭今夜长，明月香帏悄。\n纵使梦相逢，何处寻蓬岛。", "lines": ["银缸委坠红，碧锁朦胧晓。", "别泪洒金徽，一曲情多少。", "邮亭今夜长，明月香帏悄。", "纵使梦相逢，何处寻蓬岛。"], "pingsheng": ["············", "z·····zz····", "·······z····", "············"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "南歌子", "author": "蔡伸", "dynasty": "宋", "cipai": "南歌子", "text": "萧寺疏锺断，虚堂夜气清。\n凉蟾偏向小明窗。\n露井碧梧寒叶、颤秋声。\n幽恨人谁问，孤衾泪独横。\n此时风月此时情。\n拟倩蓝桥归梦、见云英。", "lines": ["萧寺疏锺断，虚堂夜气清。", "凉蟾偏向小明窗。", "露井碧梧寒叶、颤秋声。", "幽恨人谁问，孤衾泪独横。", "此时风月此时情。", "拟倩蓝桥归梦、见云英。"], "pingsheng": ["············", "········", "···········", "·········z··", "···z····", "···········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "南歌子", "author": "蔡伸", "dynasty": "宋", "cipai": "南歌子", "text": "远水澄明绿，孤云暗淡愁。\n白苹红蓼满汀洲。\n肠断圆蟾空照、木兰舟。\n节物伤羁旅，归程叹滞留。\n佳期已误小红楼。\n赖得今年犹有、闰中秋。", "lines": ["远水澄明绿，孤云暗淡愁。", "白苹红蓼满汀洲。", "肠断圆蟾空照、木兰舟。", "节物伤羁旅，归程叹滞留。", "佳期已误小红楼。", "赖得今年犹有、闰中秋。"], "pingsheng": ["····z·······", "z·······", "·······z···", "zz··········", "········", "·z·········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "南歌子", "author": "蔡伸", "dynasty": "宋", "cipai": "南歌子", "text": "恨入眉峰翠，寒生酒晕红。\n临期凝泪洒西风。\n须信世间无物、似情浓。\n玉蹬敲霜月，金钲伴晓锺。\n凄凉古驿乱山重。\n今夜拥衾无寐、与君同。", "lines": ["恨入眉峰翠，寒生酒晕红。", "临期凝泪洒西风。", "须信世间无物、似情浓。", "玉蹬敲霜月，金钲伴晓锺。", "凄凉古驿乱山重。", "今夜拥衾无寐、与君同。"], "pingsheng": ["·z··········", "········", "·····z·····", "z···z·······", "········", "···········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "南乡子", "author": "蔡伸", "dynasty": "宋", "cipai": "南乡子", "text": "天外雨初收。\n风紧云轻已变秋。\n邂逅故人同一笑，迟留。\n聚散人生宜自谋。\n去路指南州。\n万顷云涛一叶舟。\n莫话太湖波浪险，归休。\n人在溪边正倚楼。", "lines": ["天外雨初收。", "风紧云轻已变秋。", "邂逅故人同一笑，迟留。", "聚散人生宜自谋。", "去路指南州。", "万顷云涛一叶舟。", "莫话太湖波浪险，归休。", "人在溪边正倚楼。"], "pingsheng": ["······", "········", "·····z·····", "········", "······", "····z···", "···········", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "南乡子", "author": "蔡伸", "dynasty": "宋", "cipai": "南乡子", "text": "木落雁南翔。\n锦鲤殷勤为渡江。\n泪墨银钩相忆字，成行。\n滴损云笺小凤皇。\n陈事费思量。\n回首烟波卷夕阳。\n尽道凭书聊破恨，难忘。\n及至书来更断肠。", "lines": ["木落雁南翔。", "锦鲤殷勤为渡江。", "泪墨银钩相忆字，成行。", "滴损云笺小凤皇。", "陈事费思量。", "回首烟波卷夕阳。", "尽道凭书聊破恨，难忘。", "及至书来更断肠。"], "pingsheng": ["zz····", "········", "·z·········", "········", "······", "·····z··", "···········", "z·······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "鸳鸯枕上云堆绿。\n兰膏微润知新沐。\n开帐对华灯。\n见郎双眼明。\n锦衾香馥郁。\n槛竹敲寒玉。\n何物最无情。\n晓鸡咿喔声。", "lines": ["鸳鸯枕上云堆绿。", "兰膏微润知新沐。", "开帐对华灯。", "见郎双眼明。", "锦衾香馥郁。", "槛竹敲寒玉。", "何物最无情。", "晓鸡咿喔声。"], "pingsheng": ["······z·", "········", "······", "······", "······", "·z··z·", "·z····", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "杏花零落清明雨。\n卷帘双燕来还去。\n枕上玉芙蓉。\n暖香堆锦红。\n翠翘金钿雀。\n蝉鬓慵疏掠。\n心事一春闲。\n黛眉颦远山。", "lines": ["杏花零落清明雨。", "卷帘双燕来还去。", "枕上玉芙蓉。", "暖香堆锦红。", "翠翘金钿雀。", "蝉鬓慵疏掠。", "心事一春闲。", "黛眉颦远山。"], "pingsheng": ["···z····", "········", "··z···", "······", "······", "······", "··z···", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "飞英不向枝头住。\n等闲又送春归去。\n云幄翠阴浮。\n长随日脚流。\n玉箫吹凤怨。\n惊起楼中燕。\n飞去自双双。\n恼人空断肠。", "lines": ["飞英不向枝头住。", "等闲又送春归去。", "云幄翠阴浮。", "长随日脚流。", "玉箫吹凤怨。", "惊起楼中燕。", "飞去自双双。", "恼人空断肠。"], "pingsheng": ["········", "········", "······", "··z···", "z·····", "······", "······", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "水光山影浮空碧。\n柳丝摇曳春无力。\n柳岸系行舟。\n吹箫忆旧游。\n旧游堪更忆。\n望断迷南北。\n千古恨悠悠。\n长江空自流。", "lines": ["水光山影浮空碧。", "柳丝摇曳春无力。", "柳岸系行舟。", "吹箫忆旧游。", "旧游堪更忆。", "望断迷南北。", "千古恨悠悠。", "长江空自流。"], "pingsheng": ["········", "······z·", "······", "······", "······", "····z·", "······", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "当时携手今千里。\n可堪重到相逢地。\n触目尽关心。\n流莺尚好音。\n无人知我意。\n只有涓涓泪。\n寂寞到斜阳。\n罗衣裛旧香。", "lines": ["当时携手今千里。", "可堪重到相逢地。", "触目尽关心。", "流莺尚好音。", "无人知我意。", "只有涓涓泪。", "寂寞到斜阳。", "罗衣裛旧香。"], "pingsheng": ["········", "········", "·z····", "······", "······", "······", "······", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "鸣茄叠鼓催双桨。\n扁舟稳泛桃花浪。\n别泪洒东风。\n前欢如梦中。\n梦魂无定据。\n不到相逢处。\n纵使梦相逢。\n香闺岂解同。", "lines": ["鸣茄叠鼓催双桨。", "扁舟稳泛桃花浪。", "别泪洒东风。", "前欢如梦中。", "梦魂无定据。", "不到相逢处。", "纵使梦相逢。", "香闺岂解同。"], "pingsheng": ["········", "········", "z·····", "······", "······", "······", "······", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "金铺半掩银瞻满。\n个人应恨归来晚。\n轧轧橹声迟。\n那知心已飞。\n迎门一笑粲。\n娇困横波慢。\n偎倚绿窗前。\n今宵人月圆。", "lines": ["金铺半掩银瞻满。", "个人应恨归来晚。", "轧轧橹声迟。", "那知心已飞。", "迎门一笑粲。", "娇困横波慢。", "偎倚绿窗前。", "今宵人月圆。"], "pingsheng": ["········", "········", "······", "······", "··z···", "······", "··z···", "···z··"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "双双紫燕来华屋。\n雨馀芳草池塘绿。\n一夜摆花风。\n莺花满树红。\n杯深君莫诉。\n醉袖歌金缕。\n无奈惜花心。\n老来情转深。", "lines": ["双双紫燕来华屋。", "雨馀芳草池塘绿。", "一夜摆花风。", "莺花满树红。", "杯深君莫诉。", "醉袖歌金缕。", "无奈惜花心。", "老来情转深。"], "pingsheng": ["······z·", "······z·", "z·····", "······", "······", "······", "··z···", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "朝来一陈狂风雨。\n春光已作堂堂去。\n茂绿满繁枝。\n青梅结子时。\n攀枝惊晼晚。\n乐事孤心眼。\n正是惜春归。\n那堪怨别离。", "lines": ["朝来一陈狂风雨。", "春光已作堂堂去。", "茂绿满繁枝。", "青梅结子时。", "攀枝惊晼晚。", "乐事孤心眼。", "正是惜春归。", "那堪怨别离。"], "pingsheng": ["··z·····", "········", "·z····", "··z···", "······", "z·····", "··z···", "···z··"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "凝羞隔水抛红豆。\n嫩桃如脸腰如柳。\n心事暗明期。\n阳台云雨迷。\n玉楼花似雪。\n花上朦胧月。\n挥泪执柔荑。\n匆匆话别时。", "lines": ["凝羞隔水抛红豆。", "嫩桃如脸腰如柳。", "心事暗明期。", "阳台云雨迷。", "玉楼花似雪。", "花上朦胧月。", "挥泪执柔荑。", "匆匆话别时。"], "pingsheng": ["··z·····", "········", "······", "······", "z···z·", "····z·", "······", "···z··"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "菩萨蛮", "author": "蔡伸", "dynasty": "宋", "cipai": "菩萨蛮", "text": "花冠鼓翼东方动。\n兰闺惊破辽阳梦。\n翠被小屏山。\n晓窗灯影残。\n并头双燕语。\n似诉横塘雨。\n风雨晓寒多。\n征人可奈何。", "lines": ["花冠鼓翼东方动。", "兰闺惊破辽阳梦。", "翠被小屏山。", "晓窗灯影残。", "并头双燕语。", "似诉横塘雨。", "风雨晓寒多。", "征人可奈何。"], "pingsheng": ["···z····", "········", "······", "······", "······", "······", "······", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "忆秦娥", "author": "蔡伸", "dynasty": "宋", "cipai": "忆秦娥", "text": "湖光碧。\n春花秋月无今昔。\n无今昔。\n十年往事，尽成陈迹。\n玉箫声断云屏隔。\n山遥水远长相忆。\n长相忆。\n一生怀抱，为君牵役。", "lines": ["湖光碧。", "春花秋月无今昔。", "无今昔。", "十年往事，尽成陈迹。", "玉箫声断云屏隔。", "山遥水远长相忆。", "长相忆。", "一生怀抱，为君牵役。"], "pingsheng": ["····", "···z····", "····", "z·········", "z·····z·", "········", "····", "z·······z·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "忆秦娥", "author": "蔡伸", "dynasty": "宋", "cipai": "忆秦娥", "text": "花阴月。\n兰堂夜宴神仙客。\n神仙客。\n江梅标韵，海棠颜色。\n良辰佳会诚难得。\n花前一醉君休惜。\n君休惜。\n楚台云雨，今夕何夕。", "lines": ["花阴月。", "兰堂夜宴神仙客。", "神仙客。", "江梅标韵，海棠颜色。", "良辰佳会诚难得。", "花前一醉君休惜。", "君休惜。", "楚台云雨，今夕何夕。"], "pingsheng": ["··z·", "······z·", "··z·", "········z·", "······z·", "··z···z·", "··z·", "······z·z·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "清平乐", "author": "蔡伸", "dynasty": "宋", "cipai": "清平乐", "text": "彩舟双橹。\n六月临平路。\n小雨轻风消晚暑。\n绕岸荷花无数。\n玉人璨枕方床。\n遥知待月西厢。\n昨夜有情风月，今宵特地凄凉。", "lines": ["彩舟双橹。", "六月临平路。", "小雨轻风消晚暑。", "绕岸荷花无数。", "玉人璨枕方床。", "遥知待月西厢。", "昨夜有情风月，今宵特地凄凉。"], "pingsheng": ["·····", "zz····", "········", "·······", "z······", "···z···", "·····z···z····"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "清平乐", "author": "蔡伸", "dynasty": "宋", "cipai": "清平乐", "text": "南窗月满。\n绣被堆香暖。\n苦恨春宵更漏短。\n应讶郎归又晚。\n征帆初落桥边。\n迎门一笑嫣然。\n今夜流霞共酌，何妨金盏垂莲。", "lines": ["南窗月满。", "绣被堆香暖。", "苦恨春宵更漏短。", "应讶郎归又晚。", "征帆初落桥边。", "迎门一笑嫣然。", "今夜流霞共酌，何妨金盏垂莲。"], "pingsheng": ["··z··", "······", "········", "·······", "···z···", "··z····", "··············"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "清平乐", "author": "蔡伸", "dynasty": "宋", "cipai": "清平乐", "text": "明眸秀色。\n肌理凝香雪。\n罗绮丛中标韵别。\n捧酒歌声清越。\n不辞醉脸潮红。\n却愁归骑匆匆。\n回首绿窗朱户，断肠明月清风。", "lines": ["明眸秀色。", "肌理凝香雪。", "罗绮丛中标韵别。", "捧酒歌声清越。", "不辞醉脸潮红。", "却愁归骑匆匆。", "回首绿窗朱户，断肠明月清风。"], "pingsheng": ["···z·", "····z·", "······z·", "·····z·", "·······", "z······", "··z·······z···"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "谒金门", "author": "蔡伸", "dynasty": "宋", "cipai": "谒金门", "text": "溪声咽。\n溪上有人离别。\n别语叮咛和泪说。\n罗巾沾泪血。\n尽做刚肠如铁。\n到此也应愁绝。\n回首断山帆影灭。\n画船空载月。", "lines": ["溪声咽。", "溪上有人离别。", "别语叮咛和泪说。", "罗巾沾泪血。", "尽做刚肠如铁。", "到此也应愁绝。", "回首断山帆影灭。", "画船空载月。"], "pingsheng": ["····", "·····z·", "z·······", "····z·", "·····z·", "·····z·", "········", "····z·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "谒金门", "author": "蔡伸", "dynasty": "宋", "cipai": "谒金门", "text": "相思切。\n触目只供愁绝。\n好梦惊回清漏咽。\n烛残香穗结。\n长恨南楼明月。\n只解照人离缺。\n同倚朱栏飞大白。\n今宵风月别。", "lines": ["相思切。", "触目只供愁绝。", "好梦惊回清漏咽。", "烛残香穗结。", "长恨南楼明月。", "只解照人离缺。", "同倚朱栏飞大白。", "今宵风月别。"], "pingsheng": ["····", "·z···z·", "········", "····z·", "·····z·", "·····z·", "······z·", "···zz·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "忆王孙", "author": "蔡伸", "dynasty": "宋", "cipai": "忆王孙", "text": "凉生冰簟怯衣单。\n明月楼高空画栏。\n满院啼螀人未眠。\n掩重关。\n乌鹊南飞风露寒。", "lines": ["凉生冰簟怯衣单。", "明月楼高空画栏。", "满院啼螀人未眠。", "掩重关。", "乌鹊南飞风露寒。"], "pingsheng": ["········", "·z······", "········", "····", "········"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "阮郎归", "author": "蔡伸", "dynasty": "宋", "cipai": "阮郎归", "text": "烟笼寒水暝禽栖。\n满庭红叶飞。\n兰堂寂寂画帘垂。\n霜浓更漏迟。\n鸳被冷，麝香微。\n强敧单枕时。\n西窗看尽月痕移。\n此情君怎知。", "lines": ["烟笼寒水暝禽栖。", "满庭红叶飞。", "兰堂寂寂画帘垂。", "霜浓更漏迟。", "鸳被冷，麝香微。", "强敧单枕时。", "西窗看尽月痕移。", "此情君怎知。"], "pingsheng": ["········", "······", "········", "······", "········", "······", "····z···", "······"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "柳梢青", "author": "蔡伸", "dynasty": "宋", "cipai": "柳梢青", "text": "数声鶗鴂。\n可怜又是，春归时节。\n满院东风，海棠铺绣，梨花飘雪。\n丁香露泣残枝，算未比、愁肠寸结。\n自是休文，多情多感，不干风月。", "lines": ["数声鶗鴂。", "可怜又是，春归时节。", "满院东风，海棠铺绣，梨花飘雪。", "丁香露泣残枝，算未比、愁肠寸结。", "自是休文，多情多感，不干风月。"], "pingsheng": ["·····", "········z·", "·············z·", "··············z·", "·············z·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "柳梢青", "author": "蔡伸", "dynasty": "宋", "cipai": "柳梢青", "text": "子规啼月。\n幽衾梦断，销魂时节。\n枕上斑斑，枝头点点，染成清血。\n凄凉断雨残云，算此恨、文君更切。\n老去情怀，春来况味，那禁离别。", "lines": ["子规啼月。", "幽衾梦断，销魂时节。", "枕上斑斑，枝头点点，染成清血。", "凄凉断雨残云，算此恨、文君更切。", "老去情怀，春来况味，那禁离别。"], "pingsheng": ["···z·", "········z·", "·············z·", "················", "·············z·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "柳梢青", "author": "蔡伸", "dynasty": "宋", "cipai": "柳梢青", "text": "联璧寻春，踏青尚意，年时携手。\n此际重来，可怜还是，年时时候。\n阴阴柳下人家，人面桃花似旧。\n但原年年，春风有信，人心长久。", "lines": ["联璧寻春，踏青尚意，年时携手。", "此际重来，可怜还是，年时时候。", "阴阴柳下人家，人面桃花似旧。", "但原年年，春风有信，人心长久。"], "pingsheng": ["·····z·········", "···············", "···z··········", "···············"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}, {"title": "好事近", "author": "蔡伸", "dynasty": "宋", "cipai": "好事近", "text": "花露滴香红，花低漏声初歇。\n人似一枝梅瘦，照冰壶清彻。\n翠娥云鬓为谁容，虫丝宝奁结。\n可惜一春憔悴，负满怀风月。", "lines": ["花露滴香红，花低漏声初歇。", "人似一枝梅瘦，照冰壶清彻。", "翠娥云鬓为谁容，虫丝宝奁结。", "可惜一春憔悴，负满怀风月。"], "pingsheng": ["·············", "··z··········", "············z·", "·zz········z·"], "source": "全宋词（chinese-poetry开源数据集）", "id": ""}]