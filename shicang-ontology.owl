    <owl:NamedIndividual rdf:about="&shicang;LuYou_ShiEr">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>示儿</rdfs:label>
        <shicang:title>示儿</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LuYou"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1210</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>死去元知万事空，但悲不见九州同。王师北定中原日，家祭无忘告乃翁</shicang:content>
        <shicang:containsImagery>九州</shicang:containsImagery>
        <shicang:containsImagery>王师</shicang:containsImagery>
        <shicang:containsImagery>中原</shicang:containsImagery>
        <shicang:expressesEmotion>爱国</shicang:expressesEmotion>
        <shicang:expressesEmotion>遗恨</shicang:expressesEmotion>
        <shicang:expressesEmotion>期盼</shicang:expressesEmotion>
        <shicang:hasTheme>爱国临终</shicang:hasTheme>
        <shicang:creationBackground>八十五岁临终绝笔，写给儿子</shicang:creationBackground>
        <shicang:sourceDataset>剑南诗稿</shicang:sourceDataset>
        <shicang:compositionPlace>山阴家中（浙江绍兴）</shicang:compositionPlace>
