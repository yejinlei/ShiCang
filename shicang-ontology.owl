    <owl:NamedIndividual rdf:about="&shicang;LiYu_YuMeiRen">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>虞美人·春花秋月何时了</rdfs:label>
        <shicang:title>虞美人·春花秋月何时了</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiYu"/>
        <shicang:dynasty>南唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">978</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>春花秋月何时了？往事知多少。小楼昨夜又东风，故国不堪回首月明中。问君能有几多愁？恰似一江春水向东流</shicang:content>
        <shicang:containsImagery>春花</shicang:containsImagery>
        <shicang:containsImagery>秋月</shicang:containsImagery>
        <shicang:containsImagery>小楼</shicang:containsImagery>
        <shicang:containsImagery>东风</shicang:containsImagery>
        <shicang:containsImagery>明月</shicang:containsImagery>
        <shicang:containsImagery>雕栏玉砌</shicang:containsImagery>
        <shicang:containsImagery>春水</shicang:containsImagery>
        <shicang:expressesEmotion>亡国之痛</shicang:expressesEmotion>
        <shicang:expressesEmotion>愁绪</shicang:expressesEmotion>
        <shicang:expressesEmotion>故国之思</shicang:expressesEmotion>
        <shicang:hasTheme>亡国抒怀</shicang:hasTheme>
        <shicang:creationBackground>亡国降宋后被囚汴京，七夕生日作此词，宋太宗闻之赐牵机药毒死</shicang:creationBackground>
        <shicang:sourceDataset>南唐二主词</shicang:sourceDataset>
        <shicang:compositionPlace>汴京囚所（河南开封）</shicang:compositionPlace>
        <shicang:contextType>亡国囚居</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#7F8C8D</shicang:themeColor>
        <shicang:themeAccent>#2C3E50</shicang:themeAccent>
        <shicang:themeBg>#F5F5F5</shicang:themeBg>
    
        <shicang:rhymeGroup>一东</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第3句、第4句</shicang:rhymeScheme>
        <shicang:rhymeLines>3,4</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiYu_YuMeiRen.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiYu_LangTaoSha">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>浪淘沙令·帘外雨潺潺</rdfs:label>
        <shicang:title>浪淘沙令·帘外雨潺潺</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiYu"/>
        <shicang:dynasty>南唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">978</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>帘外雨潺潺，春意阑珊。罗衾不耐五更寒。梦里不知身是客，一晌贪欢。流水落花春去也，天上人间</shicang:content>
        <shicang:containsImagery>雨</shicang:containsImagery>
        <shicang:containsImagery>罗衾</shicang:containsImagery>
        <shicang:containsImagery>五更寒</shicang:containsImagery>
        <shicang:containsImagery>梦里</shicang:containsImagery>
        <shicang:containsImagery>流水</shicang:containsImagery>
        <shicang:containsImagery>落花</shicang:containsImagery>
        <shicang:expressesEmotion>亡国</shicang:expressesEmotion>
        <shicang:expressesEmotion>凄凉</shicang:expressesEmotion>
        <shicang:expressesEmotion>惆怅</shicang:expressesEmotion>
        <shicang:hasTheme>亡国抒怀</shicang:hasTheme>
        <shicang:creationBackground>囚汴京时作</shicang:creationBackground>
        <shicang:sourceDataset>南唐二主词</shicang:sourceDataset>
        <shicang:compositionPlace>汴京囚所（河南开封）</shicang:compositionPlace>
        <shicang:contextType>亡国囚居</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#7F8C8D</shicang:themeColor>
        <shicang:themeAccent>#2C3E50</shicang:themeAccent>
        <shicang:themeBg>#F5F5F5</shicang:themeBg>
    
        <shicang:rhymeGroup>十四寒</shicang:rhymeGroup>
