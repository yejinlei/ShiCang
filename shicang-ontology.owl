    <owl:Ontology rdf:about="http://www.shicang.org/ontology">
        <owl:versionInfo xml:lang="zh">v4.3 · 八大典籍类型深度细化 · 2026</owl:versionInfo>
        <rdfs:label xml:lang="zh">诗藏本体论</rdfs:label>
        <rdfs:comment xml:lang="zh">参照佛藏本体论七层架构，为诗藏776部典籍建立的专属知识本体，按诗/词/曲/赋/骚/联/诗话/词话八大类型深度细化。</rdfs:comment>
    </owl:Ontology>

