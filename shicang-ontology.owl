    <owl:NamedIndividual rdf:about="&shicang;QuYuan_LiSao">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>离骚</rdfs:label>
        <shicang:title>离骚</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;QuYuan"/>
        <shicang:dynasty>战国</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">-300</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;ChuCi"/>
        <shicang:content>路漫漫其修远兮，吾将上下而求索</shicang:content>
        <shicang:containsImagery>兰</shicang:containsImagery>
        <shicang:containsImagery>芷</shicang:containsImagery>
        <shicang:containsImagery>荃</shicang:containsImagery>
        <shicang:containsImagery>蕙</shicang:containsImagery>
        <shicang:containsImagery>鸷鸟</shicang:containsImagery>
        <shicang:expressesEmotion>忧国</shicang:expressesEmotion>
        <shicang:expressesEmotion>孤愤</shicang:expressesEmotion>
        <shicang:expressesEmotion>求索</shicang:expressesEmotion>
        <shicang:hasTheme>抒怀</shicang:hasTheme>
        <shicang:creationBackground>屈原被楚怀王疏远后，怀忠被谗，忧愁幽思而作离骚</shicang:creationBackground>
        <shicang:sourceDataset>楚辞</shicang:sourceDataset>
        <shicang:compositionPlace>沅湘流域（湖南）</shicang:compositionPlace>
        <shicang:contextType>贬谪抒怀</shicang:contextType>
        <shicang:compositionSeason>夏</shicang:compositionSeason>
        <shicang:themeColor>#7F8C8D</shicang:themeColor>
        <shicang:themeAccent>#2C3E50</shicang:themeAccent>
        <shicang:themeBg>#F5F5F5</shicang:themeBg>
    
        <shicang:rhymeGroup>八齐</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句</shicang:rhymeScheme>
        <shicang:rhymeLines>1</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/QuYuan_LiSao.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;QuYuan_JiuGe_JiangJun">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>九歌·国殇</rdfs:label>
        <shicang:title>九歌·国殇</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;QuYuan"/>
        <shicang:dynasty>战国</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">-300</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;ChuCi"/>
        <shicang:content>身既死兮神以灵，子魂魄兮为鬼雄</shicang:content>
        <shicang:containsImagery>吴戈</shicang:containsImagery>
        <shicang:containsImagery>犀甲</shicang:containsImagery>
        <shicang:containsImagery>长剑</shicang:containsImagery>
        <shicang:containsImagery>秦弓</shicang:containsImagery>
        <shicang:expressesEmotion>悲壮</shicang:expressesEmotion>
        <shicang:expressesEmotion>爱国</shicang:expressesEmotion>
        <shicang:hasTheme>战争祭祀</shicang:hasTheme>
        <shicang:creationBackground>祭祀为国战死的楚军将士</shicang:creationBackground>
        <shicang:sourceDataset>楚辞</shicang:sourceDataset>
        <shicang:compositionPlace>楚地（湖北湖南）</shicang:compositionPlace>
        <shicang:contextType>战争祭祀</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#D35400</shicang:themeColor>
        <shicang:themeAccent>#C0392B</shicang:themeAccent>
        <shicang:themeBg>#FEF9F0</shicang:themeBg>
    
        <shicang:rhymeGroup>八庚</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句</shicang:rhymeScheme>
        <shicang:rhymeLines>1</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/QuYuan_JiuGe_JiangJun.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;CaoCao_DuanGeXing">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>短歌行</rdfs:label>
        <shicang:title>短歌行</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;CaoCao"/>
        <shicang:dynasty>东汉</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">208</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;YueFu"/>
        <shicang:content>对酒当歌，人生几何？譬如朝露，去日苦多。周公吐哺，天下归心</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_周公吐"/>
        <shicang:containsImagery>朝露</shicang:containsImagery>
        <shicang:containsImagery>明月</shicang:containsImagery>
        <shicang:containsImagery>乌鹊</shicang:containsImagery>
        <shicang:containsImagery>杜康</shicang:containsImagery>
        <shicang:expressesEmotion>求贤</shicang:expressesEmotion>
        <shicang:expressesEmotion>慷慨</shicang:expressesEmotion>
        <shicang:expressesEmotion>忧思</shicang:expressesEmotion>
        <shicang:hasTheme>宴饮抒怀</shicang:hasTheme>
        <shicang:creationBackground>赤壁之战前，曹操宴饮群臣，求贤若渴而作</shicang:creationBackground>
        <shicang:sourceDataset>乐府诗集</shicang:sourceDataset>
        <shicang:compositionPlace>长江赤壁战场</shicang:compositionPlace>
        <shicang:contextType>宴饮求贤</shicang:contextType>
        <shicang:compositionSeason>冬</shicang:compositionSeason>
        <shicang:themeColor>#C0392B</shicang:themeColor>
        <shicang:themeAccent>#E67E22</shicang:themeAccent>
        <shicang:themeBg>#FDF6E3</shicang:themeBg>
    
        <shicang:rhymeGroup>五歌</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第4句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,4</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/CaoCao_DuanGeXing.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;CaoCao_GuanCangHai">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>观沧海</rdfs:label>
        <shicang:title>观沧海</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;CaoCao"/>
        <shicang:dynasty>东汉</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">207</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;YueFu"/>
        <shicang:content>东临碣石，以观沧海。日月之行，若出其中；星汉灿烂，若出其里</shicang:content>
        <shicang:containsImagery>沧海</shicang:containsImagery>
        <shicang:containsImagery>日月</shicang:containsImagery>
        <shicang:containsImagery>洪波</shicang:containsImagery>
        <shicang:containsImagery>碣石</shicang:containsImagery>
        <shicang:expressesEmotion>豪迈</shicang:expressesEmotion>
        <shicang:expressesEmotion>壮阔</shicang:expressesEmotion>
        <shicang:hasTheme>山水抒怀</shicang:hasTheme>
        <shicang:creationBackground>北征乌桓得胜回师，登碣石山望海而作</shicang:creationBackground>
        <shicang:sourceDataset>乐府诗集</shicang:sourceDataset>
        <shicang:compositionPlace>碣石山（河北昌黎）</shicang:compositionPlace>
        <shicang:contextType>登山望海</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#C0392B</shicang:themeColor>
        <shicang:themeAccent>#E67E22</shicang:themeAccent>
        <shicang:themeBg>#FDF6E3</shicang:themeBg>
    
        <shicang:rhymeGroup>支</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句</shicang:rhymeScheme>
        <shicang:rhymeLines>1</shicang:rhymeLines>
        <shicang:studyTheme>豪放壮阔</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/CaoCao_GuanCangHai.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;CaoZhi_LuoShenFu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>洛神赋</rdfs:label>
        <shicang:title>洛神赋</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;CaoZhi"/>
        <shicang:dynasty>三国魏</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">223</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Fu"/>
        <shicang:content>翩若惊鸿，婉若游龙，荣曜秋菊，华茂春松</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_宓妃"/>
        <shicang:containsImagery>洛神</shicang:containsImagery>
        <shicang:containsImagery>惊鸿</shicang:containsImagery>
        <shicang:containsImagery>游龙</shicang:containsImagery>
        <shicang:containsImagery>秋水</shicang:containsImagery>
        <shicang:containsImagery>春松</shicang:containsImagery>
        <shicang:expressesEmotion>怅惘</shicang:expressesEmotion>
        <shicang:expressesEmotion>爱慕</shicang:expressesEmotion>
        <shicang:hasTheme>爱情抒情</shicang:hasTheme>
        <shicang:creationBackground>曹植过洛水，感宋玉神女之事而作</shicang:creationBackground>
        <shicang:sourceDataset>文选</shicang:sourceDataset>
        <shicang:compositionPlace>洛水之滨（河南洛阳）</shicang:compositionPlace>
        <shicang:contextType>感梦抒怀</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>二冬</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>深情婉约</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/CaoZhi_LuoShenFu.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;TaoYuanming_YinJiu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>饮酒·其五</rdfs:label>
        <shicang:title>饮酒·其五</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;TaoYuanming"/>
        <shicang:dynasty>东晋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">417</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;GuTiShi"/>
        <shicang:content>采菊东篱下，悠然见南山。山气日夕佳，飞鸟相与还</shicang:content>
        <shicang:containsImagery>菊</shicang:containsImagery>
        <shicang:containsImagery>东篱</shicang:containsImagery>
        <shicang:containsImagery>南山</shicang:containsImagery>
        <shicang:containsImagery>飞鸟</shicang:containsImagery>
        <shicang:expressesEmotion>闲适</shicang:expressesEmotion>
        <shicang:expressesEmotion>淡泊</shicang:expressesEmotion>
        <shicang:expressesEmotion>悠然</shicang:expressesEmotion>
        <shicang:hasTheme>田园隐逸</shicang:hasTheme>
        <shicang:creationBackground>辞官归隐田园后作，写隐居生活之乐</shicang:creationBackground>
        <shicang:sourceDataset>陶渊明集</shicang:sourceDataset>
        <shicang:compositionPlace>柴桑栗里（江西九江）</shicang:compositionPlace>
        <shicang:contextType>田园隐居</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#27AE60</shicang:themeColor>
        <shicang:themeAccent>#16A085</shicang:themeAccent>
        <shicang:themeBg>#F4FAF0</shicang:themeBg>
    
        <shicang:rhymeGroup>十五删</shicang:rhymeGroup>
        <shicang:rhymeScheme>二、四句押韵（abcb 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>2,4</shicang:rhymeLines>
        <shicang:studyTheme>恬淡闲适</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/TaoYuanming_YinJiu.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;TaoYuanming_GuiQuLaiXi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>归去来兮辞</rdfs:label>
        <shicang:title>归去来兮辞</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;TaoYuanming"/>
        <shicang:dynasty>东晋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">405</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Fu"/>
        <shicang:content>归去来兮，田园将芜胡不归？木欣欣以向荣，泉涓涓而始流</shicang:content>
        <shicang:containsImagery>松菊</shicang:containsImagery>
        <shicang:containsImagery>孤舟</shicang:containsImagery>
        <shicang:containsImagery>归鸟</shicang:containsImagery>
        <shicang:containsImagery>田园</shicang:containsImagery>
        <shicang:expressesEmotion>释然</shicang:expressesEmotion>
        <shicang:expressesEmotion>喜悦</shicang:expressesEmotion>
        <shicang:expressesEmotion>归隐</shicang:expressesEmotion>
        <shicang:hasTheme>归隐抒怀</shicang:hasTheme>
        <shicang:creationBackground>辞去彭泽县令，归隐之初作</shicang:creationBackground>
        <shicang:sourceDataset>陶渊明集</shicang:sourceDataset>
        <shicang:compositionPlace>彭泽归乡途中</shicang:compositionPlace>
        <shicang:contextType>辞官归隐</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#27AE60</shicang:themeColor>
        <shicang:themeAccent>#16A085</shicang:themeAccent>
        <shicang:themeBg>#F4FAF0</shicang:themeBg>
    
        <shicang:rhymeGroup>八齐</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2</shicang:rhymeLines>
        <shicang:studyTheme>恬淡闲适</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/TaoYuanming_GuiQuLaiXi.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;TaoYuanming_TaoHuaYuan">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>桃花源记</rdfs:label>
        <shicang:title>桃花源记</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;TaoYuanming"/>
        <shicang:dynasty>东晋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">421</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Fu"/>
        <shicang:content>阡陌交通，鸡犬相闻。黄发垂髫，并怡然自乐</shicang:content>
        <shicang:containsImagery>桃花</shicang:containsImagery>
