    <owl:NamedIndividual rdf:about="&shicang;LiBai_JingYeSi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>静夜思</rdfs:label>
        <shicang:title>静夜思</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiBai"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">726</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;WuJue"/>
        <shicang:content>床前明月光，疑是地上霜。举头望明月，低头思故乡</shicang:content>
        <shicang:containsImagery>明月</shicang:containsImagery>
        <shicang:containsImagery>霜</shicang:containsImagery>
        <shicang:expressesEmotion>思乡</shicang:expressesEmotion>
        <shicang:hasTheme>思乡</shicang:hasTheme>
        <shicang:creationBackground>二十六岁客居扬州旅舍，秋夜望月思乡</shicang:creationBackground>
        <shicang:sourceDataset>李太白集</shicang:sourceDataset>
        <shicang:compositionPlace>扬州旅舍（江苏）</shicang:compositionPlace>
        <shicang:contextType>旅夜思乡</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>七阳</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiBai_JingYeSi.html</shicang:studyPage>
        <shicang:vernacularTranslation>明亮的月光洒在床前，一片清冷。　恍惚间以为是地上结了一层白霜。　抬起头来，望着天上那轮明月。　低下头去，思念起远方的故乡。</shicang:vernacularTranslation>
        <shicang:englishTranslation>Before my bed the moonlight glimmers bright; I take it for white frost upon the ground. I lift my head and gaze upon the moon; I bow my head and think of my old home.</shicang:englishTranslation>
        <shicang:appreciation>全诗二十字，无一难字，无一僻典，却成为千年思乡第一诗。妙处在『疑』字：月色与霜色本难分辨，一『疑』写尽夜半初醒的恍惚。三四句以『举头』『低头』一组对称动作收束，空间上由地上而天上、由天上而心中，乡愁不著一字而尽得风流。</shicang:appreciation>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiBai_WangLuShanPuBu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>望庐山瀑布</rdfs:label>
        <shicang:title>望庐山瀑布</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiBai"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">725</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>日照香炉生紫烟，遥看瀑布挂前川。飞流直下三千尺，疑是银河落九天</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_银河"/>
        <shicang:containsImagery>香炉峰</shicang:containsImagery>
        <shicang:containsImagery>紫烟</shicang:containsImagery>
        <shicang:containsImagery>瀑布</shicang:containsImagery>
        <shicang:containsImagery>银河</shicang:containsImagery>
        <shicang:expressesEmotion>雄奇</shicang:expressesEmotion>
        <shicang:expressesEmotion>赞叹</shicang:expressesEmotion>
        <shicang:hasTheme>山水</shicang:hasTheme>
        <shicang:creationBackground>出蜀漫游途中登庐山作</shicang:creationBackground>
        <shicang:sourceDataset>李太白集</shicang:sourceDataset>
        <shicang:compositionPlace>庐山香炉峰（江西九江）</shicang:compositionPlace>
        <shicang:contextType>登山观瀑</shicang:contextType>
        <shicang:compositionSeason>夏</shicang:compositionSeason>
        <shicang:themeColor>#C0392B</shicang:themeColor>
        <shicang:themeAccent>#E67E22</shicang:themeAccent>
        <shicang:themeBg>#FDF6E3</shicang:themeBg>
    
