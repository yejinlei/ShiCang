    <owl:NamedIndividual rdf:about="&shicang;LiBai_ShuDaoNan">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>蜀道难</rdfs:label>
        <shicang:title>蜀道难</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiBai"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">742</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;YueFu"/>
        <shicang:content>蜀道之难，难于上青天！黄鹤之飞尚不得过，猿猱欲度愁攀援</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_蚕丛及"/>
        <shicang:containsImagery>蜀山</shicang:containsImagery>
        <shicang:containsImagery>黄鹤</shicang:containsImagery>
        <shicang:containsImagery>猿猱</shicang:containsImagery>
        <shicang:containsImagery>剑阁</shicang:containsImagery>
        <shicang:containsImagery>青泥</shicang:containsImagery>
        <shicang:expressesEmotion>雄奇</shicang:expressesEmotion>
        <shicang:expressesEmotion>惊叹</shicang:expressesEmotion>
        <shicang:expressesEmotion>豪放</shicang:expressesEmotion>
        <shicang:hasTheme>山川行旅</shicang:hasTheme>
        <shicang:creationBackground>初到长安见贺知章所作，贺读后称其为谪仙人</shicang:creationBackground>
        <shicang:sourceDataset>李太白集</shicang:sourceDataset>
        <shicang:compositionPlace>长安往蜀道途中</shicang:compositionPlace>
        <shicang:contextType>咏山川</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
