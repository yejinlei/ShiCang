    <owl:NamedIndividual rdf:about="&shicang;ChenZiang_DengYouZhouTai">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>登幽州台歌</rdfs:label>
        <shicang:title>登幽州台歌</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;ChenZiang"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">696</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;GuTiShi"/>
        <shicang:content>前不见古人，后不见来者。念天地之悠悠，独怆然而涕下</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_燕昭王"/>
