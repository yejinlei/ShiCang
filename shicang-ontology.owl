        <shicang:themeAccent>#78909C</shicang:themeAccent>
        <shicang:themeBg>#F5F8F9</shicang:themeBg>
    
        <shicang:rhymeGroup>十灰</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第3句、第5句、第6句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,3,5,6</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/YanShu_HuanXiSha.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;OuyangXiu_ZuiWengTingJi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>醉翁亭记</rdfs:label>
        <shicang:title>醉翁亭记</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;OuyangXiu"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1046</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;SanWen"/>
        <shicang:content>醉翁之意不在酒，在乎山水之间也。山水之乐，得之心而寓之酒也</shicang:content>
        <shicang:containsImagery>醉翁亭</shicang:containsImagery>
        <shicang:containsImagery>琅琊山</shicang:containsImagery>
