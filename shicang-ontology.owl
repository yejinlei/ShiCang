    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;TangYin_TaoHuaAnGe">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>桃花庵歌</rdfs:label>
        <shicang:title>桃花庵歌</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;TangYin"/>
        <shicang:dynasty>明</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1505</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiYanGuFeng"/>
        <shicang:content>桃花坞里桃花庵，桃花庵下桃花仙。桃花仙人种桃树，又摘桃花换酒钱。别人笑我忒疯癫，我笑他人看不穿。不见五陵豪杰墓，无花无酒锄作田</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_五陵豪"/>
        <shicang:containsImagery>桃花坞</shicang:containsImagery>
        <shicang:containsImagery>桃花庵</shicang:containsImagery>
        <shicang:containsImagery>桃花仙</shicang:containsImagery>
        <shicang:containsImagery>桃树</shicang:containsImagery>
        <shicang:containsImagery>酒</shicang:containsImagery>
        <shicang:containsImagery>花</shicang:containsImagery>
        <shicang:expressesEmotion>旷达</shicang:expressesEmotion>
        <shicang:expressesEmotion>傲岸</shicang:expressesEmotion>
        <shicang:expressesEmotion>风流</shicang:expressesEmotion>
        <shicang:expressesEmotion>超脱</shicang:expressesEmotion>
        <shicang:hasTheme>抒怀明志</shicang:hasTheme>
        <shicang:creationBackground>科场舞弊案后绝意仕进，居苏州桃花坞作</shicang:creationBackground>
        <shicang:sourceDataset>六如居士集</shicang:sourceDataset>
        <shicang:compositionPlace>苏州桃花坞（江苏）</shicang:compositionPlace>
        <shicang:contextType>隐居明志</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#27AE60</shicang:themeColor>
        <shicang:themeAccent>#16A085</shicang:themeAccent>
        <shicang:themeBg>#F4FAF0</shicang:themeBg>
    
        <shicang:rhymeGroup>一先</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第4句、第5句、第6句、第8句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4,5,6,8</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/TangYin_TaoHuaAnGe.html</shicang:studyPage>
