    <owl:NamedIndividual rdf:about="&shicang;LiuYuxi_ChouLeTian">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>酬乐天扬州初逢席上见赠</rdfs:label>
        <shicang:title>酬乐天扬州初逢席上见赠</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiuYuxi"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">826</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiLv"/>
        <shicang:content>沉舟侧畔千帆过，病树前头万木春。今日听君歌一曲，暂凭杯酒长精神</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_闻笛赋"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_烂柯人"/>
        <shicang:containsImagery>沉舟</shicang:containsImagery>
        <shicang:containsImagery>千帆</shicang:containsImagery>
        <shicang:containsImagery>病树</shicang:containsImagery>
        <shicang:containsImagery>万木</shicang:containsImagery>
        <shicang:containsImagery>酒</shicang:containsImagery>
        <shicang:expressesEmotion>豁达</shicang:expressesEmotion>
        <shicang:expressesEmotion>振作</shicang:expressesEmotion>
        <shicang:expressesEmotion>感慨</shicang:expressesEmotion>
        <shicang:hasTheme>酬赠抒怀</shicang:hasTheme>
        <shicang:creationBackground>罢和州刺史返洛阳，扬州初遇白居易，席上酬答</shicang:creationBackground>
        <shicang:sourceDataset>刘梦得文集</shicang:sourceDataset>
        <shicang:compositionPlace>扬州（江苏）</shicang:compositionPlace>
        <shicang:contextType>席上酬答</shicang:contextType>
        <shicang:compositionSeason>冬</shicang:compositionSeason>
        <shicang:themeColor>#2980B9</shicang:themeColor>
        <shicang:themeAccent>#3498DB</shicang:themeAccent>
        <shicang:themeBg>#F0F7FC</shicang:themeBg>
    
        <shicang:rhymeGroup>十一真</shicang:rhymeGroup>
        <shicang:rhymeScheme>二、四句押韵（abcb 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>2,4</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiuYuxi_ChouLeTian.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiHe_YanMenTaiShouXing">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>雁门太守行</rdfs:label>
        <shicang:title>雁门太守行</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiHe"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">809</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;YueFu"/>
        <shicang:content>黑云压城城欲摧，甲光向日金鳞开。报君黄金台上意，提携玉龙为君死</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_黄金台"/>
        <shicang:containsImagery>黑云</shicang:containsImagery>
        <shicang:containsImagery>甲光</shicang:containsImagery>
        <shicang:containsImagery>金鳞</shicang:containsImagery>
        <shicang:containsImagery>角声</shicang:containsImagery>
        <shicang:containsImagery>胭脂</shicang:containsImagery>
        <shicang:containsImagery>夜紫</shicang:containsImagery>
        <shicang:containsImagery>红旗</shicang:containsImagery>
        <shicang:containsImagery>玉龙</shicang:containsImagery>
        <shicang:expressesEmotion>悲壮</shicang:expressesEmotion>
        <shicang:expressesEmotion>忠勇</shicang:expressesEmotion>
        <shicang:expressesEmotion>奇诡</shicang:expressesEmotion>
        <shicang:hasTheme>边塞战争</shicang:hasTheme>
        <shicang:creationBackground>谒韩愈时呈献此诗，写平叛战事</shicang:creationBackground>
        <shicang:sourceDataset>李长吉歌诗</shicang:sourceDataset>
        <shicang:compositionPlace>雁门郡（山西代县）</shicang:compositionPlace>
        <shicang:contextType>平叛战事</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#D35400</shicang:themeColor>
        <shicang:themeAccent>#C0392B</shicang:themeAccent>
        <shicang:themeBg>#FEF9F0</shicang:themeBg>
    
        <shicang:rhymeGroup>十灰</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiHe_YanMenTaiShouXing.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;DuMu_AFangGongFu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>阿房宫赋</rdfs:label>
        <shicang:title>阿房宫赋</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;DuMu"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">825</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Fu"/>
        <shicang:content>六王毕，四海一。蜀山兀，阿房出。后人哀之而不鉴之，亦使后人而复哀后人也</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_秦始皇"/>
        <shicang:containsImagery>阿房宫</shicang:containsImagery>
        <shicang:containsImagery>蜀山</shicang:containsImagery>
        <shicang:containsImagery>廊腰缦回</shicang:containsImagery>
        <shicang:containsImagery>檐牙高啄</shicang:containsImagery>
        <shicang:expressesEmotion>警示</shicang:expressesEmotion>
        <shicang:expressesEmotion>感慨</shicang:expressesEmotion>
        <shicang:hasTheme>咏史讽喻</shicang:hasTheme>
        <shicang:creationBackground>敬宗大起宫室，作此赋以讽谏</shicang:creationBackground>
        <shicang:sourceDataset>樊川文集</shicang:sourceDataset>
        <shicang:compositionPlace>长安（陕西西安）</shicang:compositionPlace>
        <shicang:contextType>讽喻时弊</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#795548</shicang:themeColor>
        <shicang:themeAccent>#8D6E63</shicang:themeAccent>
        <shicang:themeBg>#FAF6F0</shicang:themeBg>
    
        <shicang:rhymeGroup>支</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第3句、第4句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,3,4</shicang:rhymeLines>
        <shicang:studyTheme>怀古沧桑</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/DuMu_AFangGongFu.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;DuMu_QingMing">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>清明</rdfs:label>
        <shicang:title>清明</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;DuMu"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">840</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>清明时节雨纷纷，路上行人欲断魂。借问酒家何处有，牧童遥指杏花村</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_清明节"/>
        <shicang:containsImagery>春雨</shicang:containsImagery>
        <shicang:containsImagery>行人</shicang:containsImagery>
        <shicang:containsImagery>酒家</shicang:containsImagery>
        <shicang:containsImagery>牧童</shicang:containsImagery>
        <shicang:containsImagery>杏花村</shicang:containsImagery>
        <shicang:expressesEmotion>怅惘</shicang:expressesEmotion>
        <shicang:expressesEmotion>清明愁绪</shicang:expressesEmotion>
        <shicang:hasTheme>节令行旅</shicang:hasTheme>
        <shicang:sourceDataset>全唐诗</shicang:sourceDataset>
        <shicang:compositionPlace>池州（安徽贵池）</shicang:compositionPlace>
        <shicang:contextType>清明行旅</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#607D8B</shicang:themeColor>
        <shicang:themeAccent>#78909C</shicang:themeAccent>
        <shicang:themeBg>#F5F8F9</shicang:themeBg>
    
        <shicang:rhymeGroup>十三元</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/DuMu_QingMing.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;DuMu_BoQinHuai">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>泊秦淮</rdfs:label>
        <shicang:title>泊秦淮</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;DuMu"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">840</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>烟笼寒水月笼沙，夜泊秦淮近酒家。商女不知亡国恨，隔江犹唱后庭花</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_陈后主"/>
        <shicang:containsImagery>烟</shicang:containsImagery>
        <shicang:containsImagery>寒水</shicang:containsImagery>
        <shicang:containsImagery>月</shicang:containsImagery>
        <shicang:containsImagery>沙</shicang:containsImagery>
        <shicang:containsImagery>秦淮河</shicang:containsImagery>
        <shicang:containsImagery>酒家</shicang:containsImagery>
        <shicang:containsImagery>商女</shicang:containsImagery>
        <shicang:expressesEmotion>忧国</shicang:expressesEmotion>
        <shicang:expressesEmotion>讽喻</shicang:expressesEmotion>
        <shicang:expressesEmotion>感慨</shicang:expressesEmotion>
        <shicang:hasTheme>咏史讽喻</shicang:hasTheme>
        <shicang:creationBackground>夜泊秦淮河，闻歌女唱玉树后庭花感晚唐国运作</shicang:creationBackground>
        <shicang:sourceDataset>樊川文集</shicang:sourceDataset>
        <shicang:compositionPlace>金陵秦淮河（江苏南京）</shicang:compositionPlace>
        <shicang:contextType>夜泊闻歌</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#795548</shicang:themeColor>
        <shicang:themeAccent>#8D6E63</shicang:themeAccent>
        <shicang:themeBg>#FAF6F0</shicang:themeBg>
    
        <shicang:rhymeGroup>六麻</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/DuMu_BoQinHuai.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;DuMu_ChiBi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>赤壁</rdfs:label>
        <shicang:title>赤壁</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;DuMu"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">842</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>折戟沉沙铁未销，自将磨洗认前朝。东风不与周郎便，铜雀春深锁二乔</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_赤壁之"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_周瑜"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_铜雀台"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_二乔"/>
        <shicang:containsImagery>折戟</shicang:containsImagery>
        <shicang:containsImagery>沉沙</shicang:containsImagery>
        <shicang:containsImagery>东风</shicang:containsImagery>
        <shicang:containsImagery>铜雀台</shicang:containsImagery>
        <shicang:expressesEmotion>怀古</shicang:expressesEmotion>
        <shicang:expressesEmotion>感慨</shicang:expressesEmotion>
        <shicang:hasTheme>怀古咏史</shicang:hasTheme>
        <shicang:creationBackground>黄州刺史任上经赤壁古战场作</shicang:creationBackground>
        <shicang:sourceDataset>樊川文集</shicang:sourceDataset>
        <shicang:compositionPlace>黄州赤壁（湖北黄冈）</shicang:compositionPlace>
        <shicang:contextType>登临怀古</shicang:contextType>
        <shicang:compositionSeason>夏</shicang:compositionSeason>
        <shicang:themeColor>#795548</shicang:themeColor>
        <shicang:themeAccent>#8D6E63</shicang:themeAccent>
        <shicang:themeBg>#FAF6F0</shicang:themeBg>
    
        <shicang:rhymeGroup>二萧</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>怀古沧桑</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/DuMu_ChiBi.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiShangyin_JinSe">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>锦瑟</rdfs:label>
        <shicang:title>锦瑟</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiShangyin"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">858</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiLv"/>
        <shicang:content>锦瑟无端五十弦，一弦一柱思华年。庄生晓梦迷蝴蝶，望帝春心托杜鹃。沧海月明珠有泪，蓝田日暖玉生烟</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_庄周梦"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_望帝啼"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_沧海珠"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_蓝田玉"/>
        <shicang:containsImagery>锦瑟</shicang:containsImagery>
        <shicang:containsImagery>蝴蝶</shicang:containsImagery>
        <shicang:containsImagery>杜鹃</shicang:containsImagery>
        <shicang:containsImagery>珠泪</shicang:containsImagery>
        <shicang:containsImagery>玉烟</shicang:containsImagery>
        <shicang:expressesEmotion>怅惘</shicang:expressesEmotion>
        <shicang:expressesEmotion>朦胧</shicang:expressesEmotion>
        <shicang:expressesEmotion>追忆</shicang:expressesEmotion>
        <shicang:expressesEmotion>感伤</shicang:expressesEmotion>
        <shicang:hasTheme>追忆抒怀</shicang:hasTheme>
        <shicang:creationBackground>晚年临终前自序诗，义山诗压卷之作，诗家总爱西昆好</shicang:creationBackground>
        <shicang:sourceDataset>李义山诗集</shicang:sourceDataset>
        <shicang:compositionPlace>郑州（河南）</shicang:compositionPlace>
        <shicang:contextType>晚年自序</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>一先</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第4句、第6句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4,6</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiShangyin_JinSe.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiShangyin_WuTi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>无题·相见时难别亦难</rdfs:label>
        <shicang:title>无题·相见时难别亦难</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiShangyin"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">845</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiLv"/>
        <shicang:content>相见时难别亦难，东风无力百花残。春蚕到死丝方尽，蜡炬成灰泪始干</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_蓬山"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_青鸟"/>
        <shicang:containsImagery>东风</shicang:containsImagery>
        <shicang:containsImagery>百花</shicang:containsImagery>
        <shicang:containsImagery>春蚕</shicang:containsImagery>
        <shicang:containsImagery>蜡炬</shicang:containsImagery>
        <shicang:containsImagery>蓬山</shicang:containsImagery>
        <shicang:containsImagery>青鸟</shicang:containsImagery>
        <shicang:containsImagery>云鬓</shicang:containsImagery>
        <shicang:containsImagery>月光</shicang:containsImagery>
        <shicang:expressesEmotion>爱情</shicang:expressesEmotion>
        <shicang:expressesEmotion>相思</shicang:expressesEmotion>
        <shicang:expressesEmotion>坚贞</shicang:expressesEmotion>
        <shicang:expressesEmotion>凄美</shicang:expressesEmotion>
        <shicang:hasTheme>爱情</shicang:hasTheme>
        <shicang:creationBackground>无题爱情诗经典，写离别相思之苦</shicang:creationBackground>
        <shicang:sourceDataset>李义山诗集</shicang:sourceDataset>
        <shicang:compositionPlace>泾原（甘肃泾川）</shicang:compositionPlace>
        <shicang:contextType>爱情抒怀</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>十四寒</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>深情婉约</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiShangyin_WuTi.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiShangyin_YeYuJiBei">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>夜雨寄北</rdfs:label>
        <shicang:title>夜雨寄北</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiShangyin"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">848</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>君问归期未有期，巴山夜雨涨秋池。何当共剪西窗烛，却话巴山夜雨时</shicang:content>
        <shicang:containsImagery>巴山</shicang:containsImagery>
        <shicang:containsImagery>夜雨</shicang:containsImagery>
        <shicang:containsImagery>秋池</shicang:containsImagery>
        <shicang:containsImagery>西窗</shicang:containsImagery>
        <shicang:containsImagery>烛</shicang:containsImagery>
        <shicang:expressesEmotion>相思</shicang:expressesEmotion>
        <shicang:expressesEmotion>归思</shicang:expressesEmotion>
        <shicang:expressesEmotion>温情</shicang:expressesEmotion>
        <shicang:hasTheme>思亲怀人</shicang:hasTheme>
        <shicang:creationBackground>客居巴蜀，寄给长安妻子王氏</shicang:creationBackground>
        <shicang:sourceDataset>李义山诗集</shicang:sourceDataset>
        <shicang:compositionPlace>巴蜀（四川）</shicang:compositionPlace>
        <shicang:contextType>寄妻思亲</shicang:contextType>
