    <owl:NamedIndividual rdf:about="&shicang;WangChangling_FuRongLou">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>芙蓉楼送辛渐</rdfs:label>
        <shicang:title>芙蓉楼送辛渐</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WangChangling"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">742</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>寒雨连江夜入吴，平明送客楚山孤。洛阳亲友如相问，一片冰心在玉壶</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_冰心玉"/>
        <shicang:containsImagery>寒雨</shicang:containsImagery>
        <shicang:containsImagery>江</shicang:containsImagery>
        <shicang:containsImagery>楚山</shicang:containsImagery>
        <shicang:containsImagery>冰心</shicang:containsImagery>
        <shicang:containsImagery>玉壶</shicang:containsImagery>
        <shicang:expressesEmotion>送别</shicang:expressesEmotion>
        <shicang:expressesEmotion>高洁</shicang:expressesEmotion>
        <shicang:expressesEmotion>坚贞</shicang:expressesEmotion>
        <shicang:hasTheme>送别</shicang:hasTheme>
        <shicang:creationBackground>被贬江宁丞时，送友人辛渐北上洛阳</shicang:creationBackground>
        <shicang:sourceDataset>全唐诗</shicang:sourceDataset>
        <shicang:compositionPlace>润州芙蓉楼（江苏镇江）</shicang:compositionPlace>
