        <shicang:expressesEmotion>悼亡</shicang:expressesEmotion>
        <shicang:expressesEmotion>忠贞</shicang:expressesEmotion>
        <shicang:expressesEmotion>思念</shicang:expressesEmotion>
        <shicang:hasTheme>悼亡</shicang:hasTheme>
        <shicang:creationBackground>悼念亡妻韦丛而作</shicang:creationBackground>
        <shicang:sourceDataset>元氏长庆集</shicang:sourceDataset>
