        <shicang:containsImagery>野草</shicang:containsImagery>
        <shicang:containsImagery>夕阳</shicang:containsImagery>
        <shicang:containsImagery>燕子</shicang:containsImagery>
        <shicang:containsImagery>王谢堂</shicang:containsImagery>
        <shicang:expressesEmotion>怀古</shicang:expressesEmotion>
        <shicang:expressesEmotion>沧桑</shicang:expressesEmotion>
        <shicang:expressesEmotion>兴亡感慨</shicang:expressesEmotion>
        <shicang:hasTheme>怀古</shicang:hasTheme>
        <shicang:creationBackground>和州任上游金陵作《金陵五题》之二</shicang:creationBackground>
        <shicang:sourceDataset>刘梦得文集</shicang:sourceDataset>
        <shicang:compositionPlace>金陵乌衣巷（江苏南京）</shicang:compositionPlace>
        <shicang:contextType>登临怀古</shicang:contextType>
