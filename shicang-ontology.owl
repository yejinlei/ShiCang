    <owl:NamedIndividual rdf:about="&shicang;WangChangling_ChuSai">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>出塞</rdfs:label>
        <shicang:title>出塞</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WangChangling"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">724</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>秦时明月汉时关，万里长征人未还。但使龙城飞将在，不教胡马度阴山</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_李广飞"/>
