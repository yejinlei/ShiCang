    <owl:NamedIndividual rdf:about="&shicang;BaiJuyi_ChangHenGe">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>长恨歌</rdfs:label>
        <shicang:title>长恨歌</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;BaiJuyi"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">806</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiYanGeXing"/>
        <shicang:content>在天愿作比翼鸟，在地愿为连理枝。天长地久有时尽，此恨绵绵无绝期</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_杨贵妃"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_唐玄宗"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_马嵬坡"/>
        <shicang:containsImagery>芙蓉如面柳如眉</shicang:containsImagery>
        <shicang:containsImagery>比翼鸟</shicang:containsImagery>
        <shicang:containsImagery>连理枝</shicang:containsImagery>
        <shicang:containsImagery>长生殿</shicang:containsImagery>
        <shicang:expressesEmotion>爱情</shicang:expressesEmotion>
        <shicang:expressesEmotion>怅惘</shicang:expressesEmotion>
        <shicang:expressesEmotion>悲悯</shicang:expressesEmotion>
        <shicang:hasTheme>爱情叙事</shicang:hasTheme>
        <shicang:creationBackground>盩厔县尉任上，与友人陈鸿、王质夫同游仙游寺，话及唐玄宗杨贵妃事而作</shicang:creationBackground>
        <shicang:sourceDataset>白氏长庆集</shicang:sourceDataset>
