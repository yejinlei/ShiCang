    <owl:NamedIndividual rdf:about="&shicang;WangBo_SongDuShaoFu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>送杜少府之任蜀州</rdfs:label>
        <shicang:title>送杜少府之任蜀州</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WangBo"/>
        <shicang:dynasty>唐</shicang:dynasty>
