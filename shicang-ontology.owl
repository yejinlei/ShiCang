        <shicang:themeAccent>#2C3E50</shicang:themeAccent>
        <shicang:themeBg>#F5F5F5</shicang:themeBg>
    
        <shicang:rhymeGroup>十五删</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第3句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,3</shicang:rhymeLines>
