        <shicang:hasTheme>思乡</shicang:hasTheme>
        <shicang:creationBackground>八十六岁辞官返乡，距离乡已五十余年</shicang:creationBackground>
        <shicang:sourceDataset>全唐诗</shicang:sourceDataset>
        <shicang:compositionPlace>越州永兴（浙江萧山）</shicang:compositionPlace>
        <shicang:contextType>辞官归乡</shicang:contextType>
