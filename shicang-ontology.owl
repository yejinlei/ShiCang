    <owl:NamedIndividual rdf:about="&shicang;HeZhizhang_HuiXiangOuShu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>回乡偶书</rdfs:label>
        <shicang:title>回乡偶书</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;HeZhizhang"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">744</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>少小离家老大回，乡音无改鬓毛衰。儿童相见不相识，笑问客从何处来</shicang:content>
