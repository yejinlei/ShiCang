    <owl:NamedIndividual rdf:about="&shicang;LiQingzhao_ZuiHuaYin">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>醉花阴·薄雾浓云愁永昼</rdfs:label>
        <shicang:title>醉花阴·薄雾浓云愁永昼</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiQingzhao"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1103</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>薄雾浓云愁永昼，瑞脑消金兽。东篱把酒黄昏后，有暗香盈袖。莫道不消魂，帘卷西风，人比黄花瘦</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_东篱（"/>
        <shicang:containsImagery>薄雾</shicang:containsImagery>
        <shicang:containsImagery>浓云</shicang:containsImagery>
        <shicang:containsImagery>瑞脑</shicang:containsImagery>
        <shicang:containsImagery>金兽</shicang:containsImagery>
        <shicang:containsImagery>东篱</shicang:containsImagery>
        <shicang:containsImagery>酒</shicang:containsImagery>
        <shicang:containsImagery>黄昏</shicang:containsImagery>
        <shicang:containsImagery>暗香</shicang:containsImagery>
        <shicang:containsImagery>西风</shicang:containsImagery>
        <shicang:containsImagery>黄花</shicang:containsImagery>
        <shicang:expressesEmotion>相思</shicang:expressesEmotion>
        <shicang:expressesEmotion>重阳思夫</shicang:expressesEmotion>
        <shicang:expressesEmotion>愁绪</shicang:expressesEmotion>
        <shicang:hasTheme>重阳怀人</shicang:hasTheme>
