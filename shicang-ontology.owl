        <shicang:containsImagery>酒</shicang:containsImagery>
        <shicang:expressesEmotion>旷达</shicang:expressesEmotion>
        <shicang:expressesEmotion>闲适</shicang:expressesEmotion>
        <shicang:expressesEmotion>与民同乐</shicang:expressesEmotion>
        <shicang:hasTheme>山水游记</shicang:hasTheme>
        <shicang:creationBackground>贬滁州知州，自号醉翁，作亭记</shicang:creationBackground>
        <shicang:sourceDataset>欧阳文忠公文集</shicang:sourceDataset>
        <shicang:compositionPlace>滁州琅琊山（安徽）</shicang:compositionPlace>
