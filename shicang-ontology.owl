    <!-- ==================== 八大典籍类型本体特征注释 ==================== -->
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#ShiJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">诗集本体：收录韵文诗作，按诗体细分为古风/近体/乐府/歌行等子类，属性含诗体类型(shiType)、平水韵部(yunbu)、平仄标注(pingsheng)、韵脚标注(yunjiao)、句数字数等。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#CiJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">词集本体：收录按词牌填写的词作，按长度分小令/中调/长调三子类，属性含词牌名(cipaiName)、词牌格律谱(cipaiPattern)、词体长度(ciLength)、押韵方式(ciRhymeType)等，与Cipai类关联。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#QuJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">剧曲本体：收录北曲南曲散曲杂剧传奇等，属性含曲牌名(qudiaoName)、宫调(quGongdiao)，与Qudiao类关联，含杂剧、传奇、散曲小令、套数等子类。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#ChuCiJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">楚辞本体：收录以骚体写成的楚辞类作品，按离骚体/九歌体/天问体/九章体四子类区分，属性含兮字数量(saoXiCount)，为楚地巫风文化特有的文体体系。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#HanFuJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">汉赋本体：收录赋体文学，按发展分为骚体赋/汉大赋/抒情小赋/骈赋/律赋/文赋六子类，铺采摛文，体物写志，属性含赋体类型(fuType)。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#DuiLianJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">对联本体：收录楹联对句，按用途分春联/楹联/挽联/赠联/书斋联/喜联/集句联/题赠联八子类，属性含上联(duilianUpper)、下联(duilianLower)、横批(duilianHengpi)、对联类型(duilianType)、格律评分(duilianScore)、仄起平收(duilianZeqiPingshou)、平仄相对(duilianPingzeDuidui)等专属格律属性。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#ShiHuaJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">诗话本体：收录诗歌评论著作，按体例分诗话/诗评/诗品/诗格/纪事五子类，属性含评点正文(commentContent)、评点对象(commentTarget)，与PingDian评点实例类关联，记录历代诗学理论与批评。</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.shicang.org/ontology#CiHuaJi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget xml:lang="zh">词话本体：收录词学评论著作，与诗话同属诗学理论大类，属性与诗话类同，记载词体流变、词人高下、词律辨析等词学理论。</owl:annotatedTarget>
    </owl:Axiom>

