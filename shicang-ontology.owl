    <owl:NamedIndividual rdf:about="&shicang;YuanZhen_LiSi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>离思·其四</rdfs:label>
        <shicang:title>离思·其四</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;YuanZhen"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">809</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>曾经沧海难为水，除却巫山不是云。取次花丛懒回顾，半缘修道半缘君</shicang:content>
