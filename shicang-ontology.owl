        <shicang:containsImagery>悠悠</shicang:containsImagery>
        <shicang:expressesEmotion>孤独</shicang:expressesEmotion>
        <shicang:expressesEmotion>怀才不遇</shicang:expressesEmotion>
        <shicang:expressesEmotion>苍凉</shicang:expressesEmotion>
        <shicang:hasTheme>登临怀古</shicang:hasTheme>
        <shicang:creationBackground>随武攸宜征契丹，献策不被用，登蓟北楼而作</shicang:creationBackground>
        <shicang:sourceDataset>全唐诗</shicang:sourceDataset>
