        <shicang:rhymeLines>1,2,3,4,5,6,7,8</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/NalanXingde_ChangXiangSi.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;ZhengXie_ZhuShi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>竹石</rdfs:label>
        <shicang:title>竹石</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;ZhengXie"/>
        <shicang:dynasty>清</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1740</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>咬定青山不放松，立根原在破岩中。千磨万击还坚劲，任尔东西南北风</shicang:content>
        <shicang:containsImagery>青山</shicang:containsImagery>
        <shicang:containsImagery>竹</shicang:containsImagery>
        <shicang:containsImagery>破岩</shicang:containsImagery>
        <shicang:containsImagery>风</shicang:containsImagery>
        <shicang:expressesEmotion>坚劲</shicang:expressesEmotion>
        <shicang:expressesEmotion>刚正</shicang:expressesEmotion>
        <shicang:expressesEmotion>高洁</shicang:expressesEmotion>
        <shicang:expressesEmotion>傲岸</shicang:expressesEmotion>
        <shicang:hasTheme>题画明志</shicang:hasTheme>
        <shicang:creationBackground>题自己画的竹石图，自明气节</shicang:creationBackground>
        <shicang:sourceDataset>板桥集</shicang:sourceDataset>
        <shicang:compositionPlace>扬州（江苏）</shicang:compositionPlace>
        <shicang:contextType>题画竹石</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#2980B9</shicang:themeColor>
        <shicang:themeAccent>#3498DB</shicang:themeAccent>
        <shicang:themeBg>#F0F7FC</shicang:themeBg>
    
        <shicang:rhymeGroup>一东</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/ZhengXie_ZhuShi.html</shicang:studyPage>
        <shicang:vernacularTranslation>紧紧咬住青山，绝不放松。　它的根原本就扎在破裂的岩石之中。　经历千万次磨难打击，依然坚韧刚劲。　任凭你从东西南北刮来狂风。</shicang:vernacularTranslation>
        <shicang:englishTranslation>Biting firm the green mountain, it will not let go; Its roots were planted deep in broken rock. Through a thousand grindings and ten thousand blows it stays strong: Let the winds blow from east, west, south, or north.</shicang:englishTranslation>
        <shicang:appreciation>这是一首题画诗，画的是竹，写的是人。『咬定』『立根』以拟人之笔写竹之根性，一个『咬』字把竹的倔强写活；三四句由形入神，『千磨万击』『东西南北风』极写外境之恶，而竹『还坚劲』『任尔』，从容不屈。全诗借物咏志，正是诗人清正刚直、不随流俗的人格写照。</shicang:appreciation>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;YuanMei_CangShanShiHua">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>随园诗话</rdfs:label>
        <shicang:title>随园诗话</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;YuanMei"/>
        <shicang:dynasty>清</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1760</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;ShiHua"/>
        <shicang:content>诗言志，诗缘情，诗者，情之所钟，正在我辈</shicang:content>
        <shicang:expressesEmotion>性灵</shicang:expressesEmotion>
        <shicang:hasTheme>诗论</shicang:hasTheme>
        <shicang:creationBackground>辞官居南京随园，论诗主性灵，记当时诗坛轶事</shicang:creationBackground>
        <shicang:sourceDataset>随园诗话</shicang:sourceDataset>
    
        <shicang:rhymeGroup>四寘</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句</shicang:rhymeScheme>
        <shicang:rhymeLines>1</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/YuanMei_CangShanShiHua.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;CaoXueqin_HongLouMeng">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>葬花吟</rdfs:label>
        <shicang:title>葬花吟</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;CaoXueqin"/>
        <shicang:dynasty>清</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1750</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiYanGuFeng"/>
        <shicang:content>花谢花飞花满天，红消香断有谁怜？质本洁来还洁去，强于污淖陷渠沟。一朝春尽红颜老，花落人亡两不知</shicang:content>
        <shicang:containsImagery>落花</shicang:containsImagery>
        <shicang:containsImagery>花冢</shicang:containsImagery>
        <shicang:containsImagery>洁质</shicang:containsImagery>
        <shicang:containsImagery>红颜</shicang:containsImagery>
        <shicang:expressesEmotion>凄美</shicang:expressesEmotion>
        <shicang:expressesEmotion>哀婉</shicang:expressesEmotion>
        <shicang:expressesEmotion>孤高</shicang:expressesEmotion>
        <shicang:hasTheme>抒情写人</shicang:hasTheme>
        <shicang:creationBackground>《红楼梦》中林黛玉葬花时作</shicang:creationBackground>
        <shicang:sourceDataset>红楼梦</shicang:sourceDataset>
        <shicang:compositionPlace>北京西山</shicang:compositionPlace>
        <shicang:contextType>悼红轩著书</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>一先</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2</shicang:rhymeLines>
        <shicang:studyTheme>深情婉约</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/CaoXueqin_HongLouMeng.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;GongZizhen_YiHaiZaShi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>己亥杂诗·其五</rdfs:label>
        <shicang:title>己亥杂诗·其五</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;GongZizhen"/>
        <shicang:dynasty>清</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1839</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>浩荡离愁白日斜，吟鞭东指即天涯。落红不是无情物，化作春泥更护花</shicang:content>
        <shicang:containsImagery>白日</shicang:containsImagery>
        <shicang:containsImagery>吟鞭</shicang:containsImagery>
        <shicang:containsImagery>落红</shicang:containsImagery>
        <shicang:containsImagery>春泥</shicang:containsImagery>
        <shicang:containsImagery>花</shicang:containsImagery>
        <shicang:expressesEmotion>忧国</shicang:expressesEmotion>
        <shicang:expressesEmotion>奉献</shicang:expressesEmotion>
        <shicang:expressesEmotion>离京愁绪</shicang:expressesEmotion>
        <shicang:hasTheme>离京抒怀</shicang:hasTheme>
        <shicang:creationBackground>辞官南归途中作己亥杂诗315首</shicang:creationBackground>
        <shicang:sourceDataset>龚自珍全集</shicang:sourceDataset>
        <shicang:compositionPlace>南归途中（江苏）</shicang:compositionPlace>
        <shicang:contextType>辞官离京</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#2980B9</shicang:themeColor>
        <shicang:themeAccent>#3498DB</shicang:themeAccent>
        <shicang:themeBg>#F0F7FC</shicang:themeBg>
    
        <shicang:rhymeGroup>六麻</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/GongZizhen_YiHaiZaShi.html</shicang:studyPage>
        <shicang:vernacularTranslation>无边的离愁随着西斜的白日涌起。　挥鞭向东，从此便是远隔天涯。　飘落的花瓣并非无情之物。　它化作春泥，反而更能养护新花。</shicang:vernacularTranslation>
        <shicang:englishTranslation>Vast, vast my parting sorrow as the white sun slants; Whipping east, at once I am at the world's end. Fallen blossoms are not heartless things: Turned to spring mud, they better nourish the flowers.</shicang:englishTranslation>
        <shicang:appreciation>诗人辞官南归途中所作。前两句以『浩荡离愁』与『白日斜』『天涯』写去国之悲，苍茫沉重；后两句忽作翻转，以『落红』自喻——虽离枝飘落，却化作春泥去滋养新花，把个人的失意升华为对国家未来的深情托付。一抑一扬，境界顿开，成为千古传诵的名句。</shicang:appreciation>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;GongZizhen_YiHaiZaShi_220">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>己亥杂诗·其二百二十</rdfs:label>
        <shicang:title>己亥杂诗·其二百二十</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;GongZizhen"/>
        <shicang:dynasty>清</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1839</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>九州生气恃风雷，万马齐喑究可哀。我劝天公重抖擞，不拘一格降人才</shicang:content>
        <shicang:containsImagery>风雷</shicang:containsImagery>
        <shicang:containsImagery>万马</shicang:containsImagery>
        <shicang:containsImagery>天公</shicang:containsImagery>
        <shicang:expressesEmotion>忧国</shicang:expressesEmotion>
        <shicang:expressesEmotion>呼唤变革</shicang:expressesEmotion>
        <shicang:hasTheme>讽喻抒怀</shicang:hasTheme>
        <shicang:creationBackground>过镇江应道士请撰青词，抒发改革愿望</shicang:creationBackground>
        <shicang:sourceDataset>龚自珍全集</shicang:sourceDataset>
        <shicang:compositionPlace>镇江（江苏）</shicang:compositionPlace>
        <shicang:contextType>应道士青词</shicang:contextType>
        <shicang:compositionSeason>夏</shicang:compositionSeason>
        <shicang:themeColor>#D35400</shicang:themeColor>
        <shicang:themeAccent>#C0392B</shicang:themeAccent>
        <shicang:themeBg>#FEF9F0</shicang:themeBg>
    
        <shicang:rhymeGroup>十灰</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，二、四句押韵（aaaa／aaba 型）</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/GongZizhen_YiHaiZaShi_220.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;WangGuowei_RenJianCiHua">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>人间词话三境界</rdfs:label>
        <shicang:title>人间词话三境界</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WangGuowei"/>
        <shicang:dynasty>近代</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1910</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;CiHua"/>
        <shicang:content>古今之成大事业、大学问者，必经过三种之境界：昨夜西风凋碧树，独上高楼，望尽天涯路；衣带渐宽终不悔，为伊消得人憔悴；众里寻他千百度，蓦然回首，那人却在灯火阑珊处</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_晏殊蝶"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_柳永蝶"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_辛弃疾"/>
        <shicang:expressesEmotion>境界</shicang:expressesEmotion>
        <shicang:hasTheme>词论</shicang:hasTheme>
        <shicang:creationBackground>融合康德叔本华美学与中国传统诗学，提出境界说</shicang:creationBackground>
        <shicang:sourceDataset>人间词话</shicang:sourceDataset>
        <shicang:compositionPlace>北京/上海</shicang:compositionPlace>
        <shicang:contextType>词学著述</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#607D8B</shicang:themeColor>
        <shicang:themeAccent>#78909C</shicang:themeAccent>
        <shicang:themeBg>#F5F8F9</shicang:themeBg>
    
        <shicang:rhymeGroup>七遇</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第2句、第4句、第7句、第9句</shicang:rhymeScheme>
        <shicang:rhymeLines>2,4,7,9</shicang:rhymeLines>
        <shicang:studyTheme>旷达超脱</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/WangGuowei_RenJianCiHua.html</shicang:studyPage>
    </owl:NamedIndividual>

