        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LiYu_LangTaoSha.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;FanZhongyan_YuJiaAo">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>渔家傲·秋思</rdfs:label>
        <shicang:title>渔家傲·秋思</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;FanZhongyan"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1040</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>塞下秋来风景异，衡阳雁去无留意。浊酒一杯家万里，燕然未勒归无计。羌管悠悠霜满地，人不寐，将军白发征夫泪</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_燕然勒"/>
        <shicang:containsImagery>塞下秋</shicang:containsImagery>
        <shicang:containsImagery>雁</shicang:containsImagery>
        <shicang:containsImagery>浊酒</shicang:containsImagery>
        <shicang:containsImagery>羌管</shicang:containsImagery>
        <shicang:containsImagery>霜</shicang:containsImagery>
        <shicang:containsImagery>白发</shicang:containsImagery>
        <shicang:containsImagery>征夫泪</shicang:containsImagery>
        <shicang:expressesEmotion>边塞</shicang:expressesEmotion>
        <shicang:expressesEmotion>思乡</shicang:expressesEmotion>
        <shicang:expressesEmotion>忧国</shicang:expressesEmotion>
        <shicang:expressesEmotion>苍凉</shicang:expressesEmotion>
        <shicang:hasTheme>边塞军旅</shicang:hasTheme>
        <shicang:creationBackground>陕西经略副使任上守边时作，开宋词豪放先声</shicang:creationBackground>
        <shicang:sourceDataset>范文正公集</shicang:sourceDataset>
        <shicang:compositionPlace>延州（陕西延安）</shicang:compositionPlace>
        <shicang:contextType>守边抒怀</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#D35400</shicang:themeColor>
        <shicang:themeAccent>#C0392B</shicang:themeAccent>
        <shicang:themeBg>#FEF9F0</shicang:themeBg>
    
        <shicang:rhymeGroup>四寘</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第3句、第4句、第5句、第6句、第7句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,3,4,5,6,7</shicang:rhymeLines>
