    <owl:NamedIndividual rdf:about="&shicang;LuYou_YouShanXiCun">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>游山西村</rdfs:label>
        <shicang:title>游山西村</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LuYou"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1167</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiLv"/>
        <shicang:content>莫笑农家腊酒浑，丰年留客足鸡豚。山重水复疑无路，柳暗花明又一村</shicang:content>
        <shicang:containsImagery>腊酒</shicang:containsImagery>
        <shicang:containsImagery>鸡豚</shicang:containsImagery>
        <shicang:containsImagery>山重水复</shicang:containsImagery>
        <shicang:containsImagery>柳暗花明</shicang:containsImagery>
        <shicang:containsImagery>箫鼓</shicang:containsImagery>
        <shicang:containsImagery>春社</shicang:containsImagery>
        <shicang:expressesEmotion>欣喜</shicang:expressesEmotion>
        <shicang:expressesEmotion>田园</shicang:expressesEmotion>
        <shicang:expressesEmotion>希望</shicang:expressesEmotion>
        <shicang:hasTheme>田园纪游</shicang:hasTheme>
        <shicang:creationBackground>罢官闲居山阴，游山西村作</shicang:creationBackground>
        <shicang:sourceDataset>剑南诗稿</shicang:sourceDataset>
        <shicang:compositionPlace>山阴乡村（浙江绍兴）</shicang:compositionPlace>
        <shicang:contextType>闲居纪游</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
