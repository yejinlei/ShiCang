    <owl:NamedIndividual rdf:about="&shicang;LiBai_ZengWangLun">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>赠汪伦</rdfs:label>
        <shicang:title>赠汪伦</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiBai"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">755</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>桃花潭水深千尺，不及汪伦送我情</shicang:content>
        <shicang:containsImagery>桃花潭</shicang:containsImagery>
        <shicang:containsImagery>舟</shicang:containsImagery>
        <shicang:expressesEmotion>友情</shicang:expressesEmotion>
        <shicang:expressesEmotion>送别</shicang:expressesEmotion>
        <shicang:hasTheme>送别</shicang:hasTheme>
