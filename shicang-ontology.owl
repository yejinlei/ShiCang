    <owl:NamedIndividual rdf:about="&shicang;LiuYuxi_WuYiXiang">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>乌衣巷</rdfs:label>
        <shicang:title>乌衣巷</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiuYuxi"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">826</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>朱雀桥边野草花，乌衣巷口夕阳斜。旧时王谢堂前燕，飞入寻常百姓家</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_王导谢"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_乌衣巷"/>
