    <owl:NamedIndividual rdf:about="&shicang;WangAnshi_BoChuanGuaZhou">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>泊船瓜洲</rdfs:label>
        <shicang:title>泊船瓜洲</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WangAnshi"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1075</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiJue"/>
        <shicang:content>京口瓜洲一水间，钟山只隔数重山。春风又绿江南岸，明月何时照我还</shicang:content>
        <shicang:containsImagery>瓜洲</shicang:containsImagery>
        <shicang:containsImagery>钟山</shicang:containsImagery>
        <shicang:containsImagery>春风</shicang:containsImagery>
        <shicang:containsImagery>江南岸</shicang:containsImagery>
        <shicang:containsImagery>明月</shicang:containsImagery>
        <shicang:expressesEmotion>思乡</shicang:expressesEmotion>
        <shicang:hasTheme>行旅思乡</shicang:hasTheme>
        <shicang:creationBackground>第二次拜相奉诏进京途中泊瓜洲作</shicang:creationBackground>
        <shicang:sourceDataset>临川先生文集</shicang:sourceDataset>
        <shicang:compositionPlace>瓜洲渡（江苏扬州）</shicang:compositionPlace>
