    <owl:NamedIndividual rdf:about="&shicang;WangBo_TengWangGeXu">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>滕王阁序</rdfs:label>
        <shicang:title>滕王阁序</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WangBo"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">675</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;PianWen"/>
        <shicang:content>落霞与孤鹜齐飞，秋水共长天一色。老当益壮，宁移白首之心？穷且益坚，不坠青云之志</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_冯唐易"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_李广难"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_孟尝高"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_阮籍猖"/>
        <shicang:containsImagery>落霞</shicang:containsImagery>
        <shicang:containsImagery>孤鹜</shicang:containsImagery>
        <shicang:containsImagery>秋水</shicang:containsImagery>
        <shicang:containsImagery>长天</shicang:containsImagery>
        <shicang:containsImagery>滕王阁</shicang:containsImagery>
        <shicang:expressesEmotion>豪迈</shicang:expressesEmotion>
        <shicang:expressesEmotion>壮志</shicang:expressesEmotion>
        <shicang:expressesEmotion>怅惘</shicang:expressesEmotion>
        <shicang:hasTheme>宴集登临</shicang:hasTheme>
        <shicang:creationBackground>赴交趾探父路过南昌，参加滕王阁宴集即席而作</shicang:creationBackground>
        <shicang:sourceDataset>王子安集</shicang:sourceDataset>
        <shicang:compositionPlace>洪州滕王阁（江西南昌）</shicang:compositionPlace>
        <shicang:contextType>宴集登临</shicang:contextType>
