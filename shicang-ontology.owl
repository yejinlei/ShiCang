    <owl:NamedIndividual rdf:about="&shicang;LiQingzhao_RuMengLing">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>如梦令·常记溪亭日暮</rdfs:label>
        <shicang:title>如梦令·常记溪亭日暮</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiQingzhao"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1099</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>常记溪亭日暮，沉醉不知归路。兴尽晚回舟，误入藕花深处。争渡，争渡，惊起一滩鸥鹭</shicang:content>
