    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;JiangKui_YangZhouMan">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>扬州慢·淮左名都</rdfs:label>
        <shicang:title>扬州慢·淮左名都</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;JiangKui"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1176</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>淮左名都，竹西佳处，解鞍少驻初程。过春风十里，尽荠麦青青。自胡马窥江去后，废池乔木，犹厌言兵。二十四桥仍在，波心荡冷月无声。念桥边红药，年年知为谁生</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_杜牧扬"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_二十四"/>
        <shicang:containsImagery>竹西亭</shicang:containsImagery>
        <shicang:containsImagery>春风十里</shicang:containsImagery>
        <shicang:containsImagery>荠麦</shicang:containsImagery>
        <shicang:containsImagery>废池乔木</shicang:containsImagery>
        <shicang:containsImagery>清角</shicang:containsImagery>
        <shicang:containsImagery>二十四桥</shicang:containsImagery>
        <shicang:containsImagery>冷月</shicang:containsImagery>
        <shicang:containsImagery>红药</shicang:containsImagery>
        <shicang:expressesEmotion>黍离之悲</shicang:expressesEmotion>
        <shicang:expressesEmotion>战乱荒凉</shicang:expressesEmotion>
        <shicang:expressesEmotion>兴亡感慨</shicang:expressesEmotion>
        <shicang:hasTheme>战乱抒怀</shicang:hasTheme>
        <shicang:creationBackground>二十余岁过扬州，见金兵南侵后扬州残破，感而作</shicang:creationBackground>
        <shicang:sourceDataset>白石道人歌曲</shicang:sourceDataset>
        <shicang:compositionPlace>扬州（江苏）</shicang:compositionPlace>
        <shicang:contextType>过扬州感战乱</shicang:contextType>
        <shicang:compositionSeason>冬</shicang:compositionSeason>
        <shicang:themeColor>#795548</shicang:themeColor>
        <shicang:themeAccent>#8D6E63</shicang:themeAccent>
        <shicang:themeBg>#FAF6F0</shicang:themeBg>
    
        <shicang:rhymeGroup>八庚</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第3句、第5句、第8句、第10句、第12句</shicang:rhymeScheme>
        <shicang:rhymeLines>3,5,8,10,12</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/JiangKui_YangZhouMan.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;WenTianXian_GuoLingDingYang">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>过零丁洋</rdfs:label>
        <shicang:title>过零丁洋</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;WenTianxiang"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1279</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;QiLv"/>
        <shicang:content>辛苦遭逢起一经，干戈寥落四周星。山河破碎风飘絮，身世浮沉雨打萍。惶恐滩头说惶恐，零丁洋里叹零丁。人生自古谁无死，留取丹心照汗青</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_惶恐滩"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_零丁洋"/>
        <shicang:containsImagery>干戈</shicang:containsImagery>
        <shicang:containsImagery>山河破碎</shicang:containsImagery>
        <shicang:containsImagery>风飘絮</shicang:containsImagery>
        <shicang:containsImagery>雨打萍</shicang:containsImagery>
        <shicang:containsImagery>丹心</shicang:containsImagery>
        <shicang:containsImagery>汗青</shicang:containsImagery>
        <shicang:expressesEmotion>爱国</shicang:expressesEmotion>
        <shicang:expressesEmotion>正气</shicang:expressesEmotion>
        <shicang:expressesEmotion>视死如归</shicang:expressesEmotion>
        <shicang:expressesEmotion>悲壮</shicang:expressesEmotion>
        <shicang:hasTheme>明志殉国</shicang:hasTheme>
        <shicang:creationBackground>兵败被元军俘虏，过零丁洋所作，拒绝张世杰招降时作</shicang:creationBackground>
        <shicang:sourceDataset>文山先生全集</shicang:sourceDataset>
        <shicang:compositionPlace>零丁洋（广东珠江口）</shicang:compositionPlace>
        <shicang:contextType>兵败被俘</shicang:contextType>
        <shicang:compositionSeason>冬</shicang:compositionSeason>
        <shicang:themeColor>#D35400</shicang:themeColor>
        <shicang:themeAccent>#C0392B</shicang:themeAccent>
        <shicang:themeBg>#FEF9F0</shicang:themeBg>
    
        <shicang:rhymeGroup>九青</shicang:rhymeGroup>
        <shicang:rhymeScheme>首句入韵，逐偶句押韵，一韵到底</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,4,6,8</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/WenTianXian_GuoLingDingYang.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;MaZhiyuan_TianJingSha_QiuSi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>天净沙·秋思</rdfs:label>
        <shicang:title>天净沙·秋思</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;MaZhiyuan"/>
        <shicang:dynasty>元</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1300</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;SanQuXiaoLing"/>
        <shicang:content>枯藤老树昏鸦，小桥流水人家，古道西风瘦马。夕阳西下，断肠人在天涯</shicang:content>
        <shicang:containsImagery>枯藤</shicang:containsImagery>
        <shicang:containsImagery>老树</shicang:containsImagery>
        <shicang:containsImagery>昏鸦</shicang:containsImagery>
        <shicang:containsImagery>小桥</shicang:containsImagery>
        <shicang:containsImagery>流水</shicang:containsImagery>
        <shicang:containsImagery>人家</shicang:containsImagery>
        <shicang:containsImagery>古道</shicang:containsImagery>
        <shicang:containsImagery>西风</shicang:containsImagery>
        <shicang:containsImagery>瘦马</shicang:containsImagery>
        <shicang:containsImagery>夕阳</shicang:containsImagery>
        <shicang:containsImagery>天涯</shicang:containsImagery>
        <shicang:expressesEmotion>秋思</shicang:expressesEmotion>
        <shicang:expressesEmotion>漂泊</shicang:expressesEmotion>
        <shicang:expressesEmotion>思乡</shicang:expressesEmotion>
        <shicang:expressesEmotion>孤寂</shicang:expressesEmotion>
        <shicang:hasTheme>羁旅秋思</shicang:hasTheme>
        <shicang:creationBackground>元人小令压卷之作，秋思之祖</shicang:creationBackground>
        <shicang:sourceDataset>东篱乐府</shicang:sourceDataset>
        <shicang:compositionPlace>浙西道中（浙江）</shicang:compositionPlace>
        <shicang:contextType>羁旅秋思</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#7F8C8D</shicang:themeColor>
        <shicang:themeAccent>#2C3E50</shicang:themeAccent>
        <shicang:themeBg>#F5F5F5</shicang:themeBg>
    
        <shicang:rhymeGroup>六麻</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第5句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,5</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/MaZhiyuan_TianJingSha_QiuSi.html</shicang:studyPage>
        <shicang:vernacularTranslation>枯藤缠绕着老树，树上落着黄昏归巢的乌鸦。　小桥下流水潺潺，旁边是几户人家。　古老的道路上，秋风萧瑟，一匹瘦马缓缓前行。　夕阳向西缓缓落下。　漂泊天涯的游子，愁肠寸断。</shicang:vernacularTranslation>
        <shicang:englishTranslation>Withered vines, old tree, a crow at dusk; A small bridge, flowing water, a few houses; An ancient road, the west wind, a lean horse; The sun sets in the west— And a heart-broken man is far at the edge of the world.</shicang:englishTranslation>
        <shicang:appreciation>二十八字，前三句纯用名词并置，如三组静物写生：『枯藤老树昏鸦』写荒败，『小桥流水人家』写温馨，『古道西风瘦马』写漂泊——一暖一冷，两两相形，愈见游子之孤。第四句『夕阳西下』以时间收拢画面，末句『断肠人在天涯』点破题旨。全篇不着一个『愁』字，而秋思满纸，被推为『秋思之祖』。</shicang:appreciation>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;ZhangYanghao_ShanPoYang">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>山坡羊·潼关怀古</rdfs:label>
        <shicang:title>山坡羊·潼关怀古</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;ZhangYanghao"/>
        <shicang:dynasty>元</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1329</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;SanQuXiaoLing"/>
        <shicang:content>峰峦如聚，波涛如怒，山河表里潼关路。望西都，意踌躇。伤心秦汉经行处，宫阙万间都做了土。兴，百姓苦；亡，百姓苦</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_西都长"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_秦汉宫"/>
        <shicang:containsImagery>峰峦</shicang:containsImagery>
        <shicang:containsImagery>波涛</shicang:containsImagery>
        <shicang:containsImagery>潼关</shicang:containsImagery>
        <shicang:containsImagery>西都</shicang:containsImagery>
        <shicang:containsImagery>宫阙</shicang:containsImagery>
        <shicang:expressesEmotion>怀古</shicang:expressesEmotion>
        <shicang:expressesEmotion>忧民</shicang:expressesEmotion>
        <shicang:expressesEmotion>沉郁</shicang:expressesEmotion>
        <shicang:hasTheme>怀古忧民</shicang:hasTheme>
        <shicang:creationBackground>陕西行台中丞任上赈灾过潼关作</shicang:creationBackground>
        <shicang:sourceDataset>云庄休居自适小乐府</shicang:sourceDataset>
        <shicang:compositionPlace>潼关（陕西）</shicang:compositionPlace>
        <shicang:contextType>赈灾途中怀古</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#7F8C8D</shicang:themeColor>
        <shicang:themeAccent>#2C3E50</shicang:themeAccent>
        <shicang:themeBg>#F5F5F5</shicang:themeBg>
    
        <shicang:rhymeGroup>七麌</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第3句、第6句、第7句、第9句、第11句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,3,6,7,9,11</shicang:rhymeLines>
