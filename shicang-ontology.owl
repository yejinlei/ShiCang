    <!-- ==================== 类体系（七层架构） ==================== -->

    <!-- ---------- L0 顶层类 ---------- -->
    <owl:Class rdf:about="http://www.shicang.org/ontology#Thing">
        <rdfs:label xml:lang="zh">诗藏本体顶层类</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Thing"/>
    </owl:Class>

    <!-- ---------- L0 元模型层 ---------- -->
    <owl:Class rdf:about="http://www.shicang.org/ontology#Entity">
        <rdfs:label xml:lang="zh">可识别实体，万物之宗</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Thing"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#TimeEntity">
        <rdfs:label xml:lang="zh">时间实体（年代、节气、时辰）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#SpaceEntity">
        <rdfs:label xml:lang="zh">空间实体（地点、地域、路线）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>

    <!-- ---------- L1 诗理本体层 ---------- -->
    <owl:Class rdf:about="http://www.shicang.org/ontology#PoeticConcept">
        <rdfs:label xml:lang="zh">诗学概念（妙悟、神韵、境界等）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#PoeticStyle">
        <rdfs:label xml:lang="zh">诗学风格（豪放、婉约、平淡等）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#Emotion">
        <rdfs:label xml:lang="zh">情感范畴（喜、怒、哀、乐、思、愁等）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#Imagery">
        <rdfs:label xml:lang="zh">意象（月、酒、梅、柳、雁等）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#Rhyme">
        <rdfs:label xml:lang="zh">韵部与声律（平水韵106部、词林正韵、中原音韵）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.shicang.org/ontology#Meter">
        <rdfs:label xml:lang="zh">格律（平仄、粘对、对仗规则）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>

    <!-- ---------- L2 范畴层（文体典制） ---------- -->
    <owl:Class rdf:about="http://www.shicang.org/ontology#Genre">
        <rdfs:label xml:lang="zh">文体范畴（诗、词、曲、赋、骚、联、话）</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#Entity"/>
    </owl:Class>

    <!-- ---------- L2a 八大文体细分类 ---------- -->
    <owl:Class rdf:about="http://www.shicang.org/ontology#ShiGenre">
