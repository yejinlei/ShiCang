    <owl:NamedIndividual rdf:about="&shicang;LuYou_ChaiTouFeng">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>钗头凤·红酥手</rdfs:label>
        <shicang:title>钗头凤·红酥手</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LuYou"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1155</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>红酥手，黄縢酒，满城春色宫墙柳。东风恶，欢情薄。一怀愁绪，几年离索。错、错、错。山盟虽在，锦书难托。莫、莫、莫</shicang:content>
        <shicang:containsImagery>红酥手</shicang:containsImagery>
        <shicang:containsImagery>黄縢酒</shicang:containsImagery>
        <shicang:containsImagery>宫墙柳</shicang:containsImagery>
        <shicang:containsImagery>东风</shicang:containsImagery>
        <shicang:containsImagery>桃花</shicang:containsImagery>
        <shicang:containsImagery>闲池阁</shicang:containsImagery>
        <shicang:expressesEmotion>爱情悲剧</shicang:expressesEmotion>
        <shicang:expressesEmotion>悔恨</shicang:expressesEmotion>
        <shicang:expressesEmotion>惆怅</shicang:expressesEmotion>
        <shicang:hasTheme>爱情悼亡</shicang:hasTheme>
        <shicang:creationBackground>沈园遇前妻唐琬，和词题壁</shicang:creationBackground>
        <shicang:sourceDataset>渭南词</shicang:sourceDataset>
        <shicang:compositionPlace>沈园（浙江绍兴）</shicang:compositionPlace>
        <shicang:contextType>遇前妻唐琬</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>七遇</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第4句、第5句、第7句、第8句、第10句、第11句</shicang:rhymeScheme>
        <shicang:rhymeLines>4,5,7,8,10,11</shicang:rhymeLines>
        <shicang:studyTheme>深情婉约</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/LuYou_ChaiTouFeng.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;XinQiji_QingYuAn">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>青玉案·元夕</rdfs:label>
        <shicang:title>青玉案·元夕</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;XinQiji"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1174</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>东风夜放花千树，更吹落星如雨。宝马雕车香满路。凤箫声动，玉壶光转，一夜鱼龙舞。众里寻他千百度，蓦然回首，那人却在灯火阑珊处</shicang:content>
        <shicang:containsImagery>东风</shicang:containsImagery>
        <shicang:containsImagery>花千树</shicang:containsImagery>
        <shicang:containsImagery>星雨</shicang:containsImagery>
        <shicang:containsImagery>宝马雕车</shicang:containsImagery>
        <shicang:containsImagery>凤箫</shicang:containsImagery>
        <shicang:containsImagery>玉壶</shicang:containsImagery>
        <shicang:containsImagery>鱼龙舞</shicang:containsImagery>
        <shicang:containsImagery>灯火</shicang:containsImagery>
        <shicang:containsImagery>阑珊</shicang:containsImagery>
        <shicang:expressesEmotion>孤高</shicang:expressesEmotion>
        <shicang:expressesEmotion>寂寞</shicang:expressesEmotion>
        <shicang:expressesEmotion>追求</shicang:expressesEmotion>
        <shicang:expressesEmotion>元宵</shicang:expressesEmotion>
        <shicang:hasTheme>元夕抒怀</shicang:hasTheme>
        <shicang:creationBackground>临安元宵节作，王国维评此为古今成大事业大学问第三境界</shicang:creationBackground>
        <shicang:sourceDataset>稼轩长短句</shicang:sourceDataset>
        <shicang:compositionPlace>临安（浙江杭州）</shicang:compositionPlace>
        <shicang:contextType>元夕观灯</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
        <shicang:themeColor>#607D8B</shicang:themeColor>
        <shicang:themeAccent>#78909C</shicang:themeAccent>
        <shicang:themeBg>#F5F8F9</shicang:themeBg>
    
        <shicang:rhymeGroup>七遇</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第2句、第3句、第6句、第7句、第9句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,2,3,6,7,9</shicang:rhymeLines>
        <shicang:studyTheme>悲慨沉郁</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/XinQiji_QingYuAn.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;XinQiji_PoZhenZi">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>破阵子·为陈同甫赋壮词以寄之</rdfs:label>
        <shicang:title>破阵子·为陈同甫赋壮词以寄之</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;XinQiji"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1188</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>醉里挑灯看剑，梦回吹角连营。八百里分麾下炙，五十弦翻塞外声，沙场秋点兵。了却君王天下事，赢得生前身后名。可怜白发生</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_八百里"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_五十弦"/>
        <shicang:containsImagery>灯</shicang:containsImagery>
        <shicang:containsImagery>剑</shicang:containsImagery>
        <shicang:containsImagery>号角连营</shicang:containsImagery>
        <shicang:containsImagery>炙</shicang:containsImagery>
        <shicang:containsImagery>沙场</shicang:containsImagery>
        <shicang:containsImagery>点兵</shicang:containsImagery>
        <shicang:containsImagery>白发</shicang:containsImagery>
        <shicang:expressesEmotion>壮志难酬</shicang:expressesEmotion>
        <shicang:expressesEmotion>悲愤</shicang:expressesEmotion>
        <shicang:expressesEmotion>豪迈</shicang:expressesEmotion>
        <shicang:expressesEmotion>爱国</shicang:expressesEmotion>
        <shicang:hasTheme>军旅抒怀</shicang:hasTheme>
        <shicang:creationBackground>与陈亮鹅湖之会后赋壮词寄之</shicang:creationBackground>
        <shicang:sourceDataset>稼轩长短句</shicang:sourceDataset>
        <shicang:compositionPlace>铅山瓢泉（江西铅山）</shicang:compositionPlace>
        <shicang:contextType>鹅湖之会后赋词</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#D35400</shicang:themeColor>
        <shicang:themeAccent>#C0392B</shicang:themeAccent>
        <shicang:themeBg>#FEF9F0</shicang:themeBg>
    
        <shicang:rhymeGroup>八庚</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第2句、第4句、第5句、第7句、第8句</shicang:rhymeScheme>
        <shicang:rhymeLines>2,4,5,7,8</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
        <shicang:studyPage>shicang-poem/XinQiji_PoZhenZi.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;XinQiji_YongYuLe">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>永遇乐·京口北固亭怀古</rdfs:label>
        <shicang:title>永遇乐·京口北固亭怀古</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;XinQiji"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1205</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>千古江山，英雄无觅孙仲谋处。舞榭歌台，风流总被雨打风吹去。斜阳草树，寻常巷陌，人道寄奴曾住。想当年金戈铁马，气吞万里如虎。廉颇老矣，尚能饭否</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_孙权"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_刘裕（"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_刘义隆"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_佛狸祠"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_廉颇"/>
        <shicang:containsImagery>江山</shicang:containsImagery>
        <shicang:containsImagery>舞榭歌台</shicang:containsImagery>
        <shicang:containsImagery>斜阳草树</shicang:containsImagery>
        <shicang:containsImagery>金戈铁马</shicang:containsImagery>
        <shicang:containsImagery>烽火</shicang:containsImagery>
        <shicang:containsImagery>扬州路</shicang:containsImagery>
        <shicang:containsImagery>廉颇</shicang:containsImagery>
        <shicang:expressesEmotion>怀古</shicang:expressesEmotion>
        <shicang:expressesEmotion>爱国</shicang:expressesEmotion>
        <shicang:expressesEmotion>壮志难酬</shicang:expressesEmotion>
        <shicang:expressesEmotion>悲愤</shicang:expressesEmotion>
        <shicang:hasTheme>怀古抒怀</shicang:hasTheme>
        <shicang:creationBackground>镇江知府任上登北固亭作，辛词压卷</shicang:creationBackground>
        <shicang:sourceDataset>稼轩长短句</shicang:sourceDataset>
        <shicang:compositionPlace>京口北固亭（江苏镇江）</shicang:compositionPlace>
        <shicang:contextType>登临怀古</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#795548</shicang:themeColor>
        <shicang:themeAccent>#8D6E63</shicang:themeAccent>
        <shicang:themeBg>#FAF6F0</shicang:themeBg>
    
        <shicang:rhymeGroup>七遇</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第2句、第5句、第7句、第9句</shicang:rhymeScheme>
        <shicang:rhymeLines>2,5,7,9</shicang:rhymeLines>
        <shicang:studyTheme>慷慨爱国</shicang:studyTheme>
        <shicang:studyDepth>deep</shicang:studyDepth>
