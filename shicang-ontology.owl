    <owl:NamedIndividual rdf:about="&shicang;CenShen_BaiXueGe">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>白雪歌送武判官归京</rdfs:label>
        <shicang:title>白雪歌送武判官归京</shicang:title>
