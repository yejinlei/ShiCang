        <shicang:studyPage>shicang-poem/LiuYong_YuLinLing.html</shicang:studyPage>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;YanShu_HuanXiSha">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>浣溪沙·一曲新词酒一杯</rdfs:label>
        <shicang:title>浣溪沙·一曲新词酒一杯</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;YanShu"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1040</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>一曲新词酒一杯，去年天气旧亭台。夕阳西下几时回？无可奈何花落去，似曾相识燕归来。小园香径独徘徊</shicang:content>
        <shicang:containsImagery>新词</shicang:containsImagery>
        <shicang:containsImagery>酒</shicang:containsImagery>
        <shicang:containsImagery>亭台</shicang:containsImagery>
        <shicang:containsImagery>夕阳</shicang:containsImagery>
        <shicang:containsImagery>落花</shicang:containsImagery>
        <shicang:containsImagery>归燕</shicang:containsImagery>
        <shicang:containsImagery>香径</shicang:containsImagery>
        <shicang:expressesEmotion>伤春</shicang:expressesEmotion>
        <shicang:expressesEmotion>惆怅</shicang:expressesEmotion>
        <shicang:expressesEmotion>闲愁</shicang:expressesEmotion>
        <shicang:hasTheme>伤春抒怀</shicang:hasTheme>
        <shicang:creationBackground>晏殊宴游即景</shicang:creationBackground>
        <shicang:sourceDataset>珠玉词</shicang:sourceDataset>
        <shicang:compositionPlace>汴京西园（河南开封）</shicang:compositionPlace>
        <shicang:contextType>宴游即景</shicang:contextType>
        <shicang:compositionSeason>春</shicang:compositionSeason>
