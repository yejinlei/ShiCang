        <shicang:expressesEmotion>爱国</shicang:expressesEmotion>
        <shicang:expressesEmotion>感慨</shicang:expressesEmotion>
        <shicang:hasTheme>边塞</shicang:hasTheme>
        <shicang:creationBackground>漫游西北边塞时作，七绝压卷之作</shicang:creationBackground>
