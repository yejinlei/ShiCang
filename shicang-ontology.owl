    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="&shicang;LiuYong_YuLinLing">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>雨霖铃·寒蝉凄切</rdfs:label>
        <shicang:title>雨霖铃·寒蝉凄切</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiuYong"/>
        <shicang:dynasty>北宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1024</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>寒蝉凄切，对长亭晚，骤雨初歇。执手相看泪眼，竟无语凝噎。多情自古伤离别，更那堪冷落清秋节！今宵酒醒何处？杨柳岸晓风残月</shicang:content>
        <shicang:containsImagery>寒蝉</shicang:containsImagery>
        <shicang:containsImagery>长亭</shicang:containsImagery>
        <shicang:containsImagery>骤雨</shicang:containsImagery>
        <shicang:containsImagery>兰舟</shicang:containsImagery>
        <shicang:containsImagery>泪眼</shicang:containsImagery>
        <shicang:containsImagery>杨柳岸</shicang:containsImagery>
        <shicang:containsImagery>晓风</shicang:containsImagery>
        <shicang:containsImagery>残月</shicang:containsImagery>
        <shicang:expressesEmotion>离别</shicang:expressesEmotion>
        <shicang:expressesEmotion>凄苦</shicang:expressesEmotion>
        <shicang:expressesEmotion>相思</shicang:expressesEmotion>
        <shicang:hasTheme>离别送别</shicang:hasTheme>
        <shicang:creationBackground>离汴京南下与情人话别作，宋金十大名曲之首</shicang:creationBackground>
        <shicang:sourceDataset>乐章集</shicang:sourceDataset>
        <shicang:compositionPlace>汴京汴河堤岸（河南开封）</shicang:compositionPlace>
        <shicang:contextType>送别情人</shicang:contextType>
        <shicang:compositionSeason>秋</shicang:compositionSeason>
        <shicang:themeColor>#8E44AD</shicang:themeColor>
        <shicang:themeAccent>#E91E63</shicang:themeAccent>
        <shicang:themeBg>#FBF5FC</shicang:themeBg>
    
        <shicang:rhymeGroup>歌</shicang:rhymeGroup>
        <shicang:rhymeScheme>押韵句：第1句、第3句、第5句、第6句、第7句、第9句</shicang:rhymeScheme>
        <shicang:rhymeLines>1,3,5,6,7,9</shicang:rhymeLines>
        <shicang:studyTheme>深情婉约</shicang:studyTheme>
