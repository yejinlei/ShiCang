    <owl:NamedIndividual rdf:about="&shicang;LiQingzhao_ShengShengMan">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>声声慢·寻寻觅觅</rdfs:label>
        <shicang:title>声声慢·寻寻觅觅</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiQingzhao"/>
        <shicang:dynasty>南宋</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">1151</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ci"/>
        <shicang:content>寻寻觅觅，冷冷清清，凄凄惨惨戚戚。乍暖还寒时候，最难将息。梧桐更兼细雨，到黄昏点点滴滴。这次第，怎一个愁字了得</shicang:content>
        <shicang:containsImagery>淡酒</shicang:containsImagery>
        <shicang:containsImagery>晚风</shicang:containsImagery>
        <shicang:containsImagery>过雁</shicang:containsImagery>
        <shicang:containsImagery>黄花</shicang:containsImagery>
        <shicang:containsImagery>梧桐</shicang:containsImagery>
        <shicang:containsImagery>细雨</shicang:containsImagery>
