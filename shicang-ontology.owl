    <owl:NamedIndividual rdf:about="&shicang;LiuYuxi_LouShiMing">
        <rdf:type rdf:resource="&shicang;Poetry"/>
        <rdfs:label>陋室铭</rdfs:label>
        <shicang:title>陋室铭</shicang:title>
        <shicang:authoredBy rdf:resource="&shicang;LiuYuxi"/>
        <shicang:dynasty>唐</shicang:dynasty>
        <shicang:compositionYear rdf:datatype="&xsd;integer">825</shicang:compositionYear>
        <shicang:hasGenre rdf:resource="&shicang;Ming"/>
        <shicang:content>山不在高，有仙则名；水不在深，有龙则灵。斯是陋室，惟吾德馨</shicang:content>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_诸葛庐"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_子云亭"/>
        <shicang:alludesTo rdf:resource="&shicang;Allusion_孔子何"/>
