        <shicang:containsImagery>苔痕</shicang:containsImagery>
        <shicang:containsImagery>草色</shicang:containsImagery>
        <shicang:containsImagery>素琴</shicang:containsImagery>
        <shicang:containsImagery>金经</shicang:containsImagery>
        <shicang:expressesEmotion>高洁</shicang:expressesEmotion>
        <shicang:expressesEmotion>傲岸</shicang:expressesEmotion>
        <shicang:expressesEmotion>旷达</shicang:expressesEmotion>
        <shicang:hasTheme>抒怀明志</shicang:hasTheme>
