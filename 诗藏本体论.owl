        <shicang:workFullText xml:lang="zh">半醉依人落珥簪天香不数海南沈时倾秋水话春心已觉吹箫归碧落从今禊饮笑山阴金杯休惜十分深</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
