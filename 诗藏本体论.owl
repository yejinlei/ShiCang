        <shicang:workFirstLine xml:lang="zh">七返朱砂反本</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">七返朱砂反本九还金液还真休将寅子数坤申但要五行成准本是水银一味周流遍历诸辰阴阳数足自通神出入岂离玄牝</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
