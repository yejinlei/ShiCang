        <shicang:rhymeChars xml:lang="zh">之橙胸封可动</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">世路如秋</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">世路如秋万里萧条君何所之想鲈乡烟水尚堪垂钓虎丘泉石尽可题诗橙弄霜黄芦飘雪白何处西风无酒旗经行地有会心之事好吐胸奇一邱封了要离问世上男儿今有谁但一尊相属居然感慨扁舟独往可是崎齐邸歌鱼扬州跨鹤风味浅深君自知匆匆去算梅边春动</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.78</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_沁园春"/>
    </owl:NamedIndividual>

