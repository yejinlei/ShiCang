        <shicang:workFullText xml:lang="zh">不比阳关去路赊使君行即返京华清江江上是吾家聚散有时思夜雨留连无计劝流霞红愁绿惨一川花</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.952</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_浣溪沙"/>
    </owl:NamedIndividual>

