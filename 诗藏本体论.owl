    <!-- ========== 新增：基于313部诗话/词话提取的诗学风格体系 ========== -->
    <owl:Class rdf:about="http://www.shicang.org/ontology#PoeticStyle">
        <rdfs:label xml:lang="zh">诗学风格</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#PoeticConcept"/>
        <rdfs:comment>从313部诗话、词话典籍中归纳的诗歌审美风格范畴，核心源头为司空图《二十四诗品》。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.shicang.org/ontology#PoeticTheoryWork">
        <rdfs:label xml:lang="zh">诗学理论典籍</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.shicang.org/ontology#CanonicalCollection"/>
        <rdfs:comment>诗话、词话类典籍，共313部，为诗藏中最具理论价值的部分。</rdfs:comment>
    </owl:Class>

