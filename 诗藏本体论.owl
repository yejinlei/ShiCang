        <shicang:rhymeChars xml:lang="zh">分根分坤</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">本自无生无灭</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">本自无生无灭强将生灭区分只如罪福亦何根妙体何曾增损我有一轮明镜从来只为蒙分今朝磨莹照乾坤万象超然难隐</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.92</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_西江月"/>
    </owl:NamedIndividual>

