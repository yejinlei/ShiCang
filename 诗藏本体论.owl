        <shicang:workFullText xml:lang="zh">分香帕子揉蓝翠欲去殷勤惠重来只约牡丹时莫遣花枝知后故开迟别来看尽闲桃李日日阑干倚催花无计问东风梦作一双蝴蝶遶芳丛</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">乐府雅词</shicang:sourceBook>
