        <shicang:workFullText xml:lang="zh">灯前欲去仍留恋肠断朱扉远未须红雨洗香腮待得蔷薇花谢便归来舞腰歌版闲时按一任傍人看金炉应见旧残煤莫使恩情容易似寒灰</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">片玉词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">1.0</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_虞美人"/>
    </owl:NamedIndividual>

