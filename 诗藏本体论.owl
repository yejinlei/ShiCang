        <shicang:workFirstLine xml:lang="zh">西园曾为梅花醉</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">西园曾为梅花醉叶翦春云细玉笙凉夜隔帘吹卧看花梢摇动一枝枝娉娉袅袅教谁惜空压纱巾侧沈香亭北又青苔唯有当时蝴蝶自飞来</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
