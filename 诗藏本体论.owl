        <shicang:workFullText xml:lang="zh">睡起纱窗问春信几番风候待去做踏青鞋履懒拈纤手尘满翠微低叶离愁推去来还又把菱花独对泪阑干羞蓬首回鸾字空怀袖金缕曲无心奏记碧桃花下夜参横斗六幅罗裙香凝处痕痕都是尊前酒到如今肠断怕回</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.852</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_满江红"/>
    </owl:NamedIndividual>

