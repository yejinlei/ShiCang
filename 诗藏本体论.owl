        <shicang:workFullText xml:lang="zh">天上三清真境三皇五帝规模瞿昙老氏仲尼徒经史深藏妙素间有真人出世来明赤子玄珠蟾光终日耀昏衢满目黄芽显露</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.98</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_西江月"/>
    </owl:NamedIndividual>

