        <shicang:rhymeChars xml:lang="zh">心音寻心</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">欲了无生妙道</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">欲了无生妙道莫如自见真心真心无相亦无音清净法身只恁此道非无外有非中亦莫求寻二边俱遣弃中心见了名为上品</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
