        <shicang:rhymeChars xml:lang="zh">臣因仁亲</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">若要真铅留汞</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">若要真铅留汞亲中不离家臣木金间隔会无因须仗媒人勾引本性爱金顺义金情恋木慈仁相吞相陷却相亲始觉男儿有孕</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
