        <shicang:rhymeChars xml:lang="zh">然娟渊愆</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">牛女情缘道合</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">牛女情缘道合龟蛇类秉天然蟾乌遇朔合婵娟二气相资运转本是乾坤妙用谁能达此深渊阳阴否隔却成愆怎得天长地远</shicang:workFullText>
