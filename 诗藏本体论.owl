        <shicang:rhymeChars xml:lang="zh">梅催杯才来</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">二月春花厌落梅</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">二月春花厌落梅仙源归路碧桃催渭城丝雨劝离杯欢意似云真薄幸客鞭摇柳正多才凤楼人待锦书来</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
