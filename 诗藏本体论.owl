        <shicang:workFirstLine xml:lang="zh">梅花自是于春懒</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">梅花自是于春懒不是春来晚看伊开在众花前便道与春无分结因缘风前月下频相就笑我如伊瘦几回冲雨过疏篱已见一番青子缀残枝</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.982</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_虞美人"/>
    </owl:NamedIndividual>

