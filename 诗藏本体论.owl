        <shicang:rhymeChars xml:lang="zh">银闻人津</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">不辨五行四象</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">不辨五行四象那分朱汞铅银修丹火候未曾闻早便称呼居隐不背自思己错更将错路教人误他永劫在迷津似恁欺心安忍</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
