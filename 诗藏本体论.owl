        <shicang:rhymeGroup xml:lang="zh">第一部</shicang:rhymeGroup>
        <shicang:rhymeChars xml:lang="zh">红匆漫看</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">满枕潇潇今夜雨</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">满枕潇潇今夜雨人共孤灯语凤凰台畔乱香红只到寻常烟月竟匆匆江上莼丝秋未采莫怨朱颜改吴山几曲碧漫漫还有许多风景待人看</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">拙政园诗余</shicang:sourceBook>
        <shicang:meterMatchScore rdf:datatype="&xsd;decimal">0.857</shicang:meterMatchScore>
        <shicang:usesCipai rdf:resource="&shicang;Cipai_虞美人"/>
    </owl:NamedIndividual>

    <!-- #1399 词：虞美人·感兴（出自《拙政园诗余》） -->
    <owl:NamedIndividual rdf:about="&shicang;ci_01398_虞美人_感兴">
