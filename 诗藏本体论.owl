        <shicang:rhymeChars xml:lang="zh">云心新亲</shicang:rhymeChars>
        <shicang:workFirstLine xml:lang="zh">世事短如春梦</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">世事短如春梦人情薄似秋云不须计较苦劳心万事原来有命幸遇三杯酒好况逢一朵花新片时欢笑且相亲明日阴晴未定</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
