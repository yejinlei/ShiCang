        <shicang:workFirstLine xml:lang="zh">我见时人说性</shicang:workFirstLine>
        <shicang:workFullText xml:lang="zh">我见时人说性只夸口急酬机及逢境界转痴迷又与愚人何异说得便须行得方名言行无亏能将慧剑斩魔魑此号如来正智</shicang:workFullText>
        <shicang:sourceBook xml:lang="zh">全宋词</shicang:sourceBook>
